__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
# Hypothesis' downloaded Unicode tables — a regenerable cache, not source. A copy was
# committed by accident once; ignoring the directory is what stops it coming back.
.hypothesis/
.venv/
# Root-level Markdown lint toolchain. Generated projects keep any frontend
# node_modules under their own feature directory and ignore it separately.
/node_modules/
# Failure artifacts written by scripts/lint-all.py and scripts/run-tests.py. Generated
# per run and read by whoever is fixing the failure — never committed.
logs/

# Worktrees Claude Code cuts for itself under `--spawn worktree` / `--worktree`. This is
# NOT the `<workspace>/.worktrees/` box tier — that one lives outside every checkout and
# `worktree.py` owns it. These land *inside* the repo, so without this line every
# `git status` carries a nested checkout as untracked, `git add -A` stages the whole of
# it, and anything reading dirtiness (`sweep.classify`, the session-start banner) calls
# the checkout `holds_uncommitted` for as long as the worktree exists.
.claude/worktrees/

# Written into checkouts by a tool outside this repo -- an `AGENTS.md` mirror of the
# root `CLAUDE.md` (2026-09-02, and again 2026-09-19 beside a `.codex/config.toml`, in
# two checkouts in the same second). The repo carries Codex-native context instead
# (`tests/test_doc_claims.py::test_the_repo_carries_no_agents_md`), and the fix pass
# commits with `add -A`, so neither may be stageable however often they reappear.
/AGENTS.md
/.codex/config.toml
