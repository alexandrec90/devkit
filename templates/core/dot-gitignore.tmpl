# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.hypothesis/
.testmondata
.coverage
.coverage.*
htmlcov/
.benchmarks/

# Secrets and local environment. `.env.example` IS committed; `.env` never is —
# it carries this checkout's ports and credentials.
.env
.env.local
*.pem
*.key

# Runtime output. `logs/` holds the diagnostic artifacts the fixer skills read;
# they are regenerated on every run and must never be committed.
logs/
artifacts/
reports/

{{#frontend}}
# Frontend
node_modules/
frontend/dist/
frontend/.vite/
{{/frontend}}
{{#archive}}
# Local data-lake staging. The lake itself lives in object storage; this is only
# the scratch area a local ingest or restore writes through.
data/
*.parquet
{{/archive}}

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# VS Code: tasks/settings/extensions are committed (they are project contract).
# Only the per-user bits are ignored.
.vscode/*.log
.vscode/.ropeproject/

# Worktrees Claude Code cuts for itself under `--spawn worktree` / `--worktree`. This is
# NOT the `<workspace>/.worktrees/` box tier — that one lives outside every checkout and
# `worktree.py` owns it. These land *inside* the repo, so without this line every
# `git status` carries a nested checkout as untracked, `git add -A` stages the whole of
# it, and anything reading dirtiness (`sweep.classify`, the session-start banner) calls
# the checkout `holds_uncommitted` for as long as the worktree exists.
.claude/worktrees/
