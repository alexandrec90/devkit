# Local git gate, in two stages. Install once per clone with `pre-commit install` — the
# `default_install_hook_types` line makes that one command wire both stages — and
# `.claude/hooks/session-start.sh` does it automatically, so agent sessions get it too.
#
# The commit stage is the fast, deterministic subset of the PR gate: fixers and
# sub-second checks, so a commit is never held up by a judgement. The pre-push stage is
# the PR gate itself — `scripts/lint-all.py`, `scripts/run-tests.py` and the hook tests,
# via devkit's `devkit-push-gate` hook — run at the moment CI would run it, so a failure
# is read from `logs/` a minute after the push attempt instead of from a workflow
# artifact ten minutes after it. `SKIP=devkit-push-gate git push` skips it on purpose.
#
# Every `rev` is pinned and moved deliberately by `pre-commit autoupdate`. That includes
# devkit's own hooks: a floating branch there would let one upstream commit change the
# gate in every repo at once, which is the same reason the PR gate pins a tag.
default_install_hook_types: [pre-commit, pre-push]
# Without this, a hook that names no stage runs at every installed one — so the fixers
# would rewrite the whole tree on every push. Only `devkit-push-gate` is a push hook.
default_stages: [pre-commit]

repos:
  # --- devkit's published hooks ------------------------------------------------
  # The alternative to `sync-devkit.py --check`, which resolves its source from
  # $DEVKIT_DIR and can only refuse when that is unset — no clone, no comparison.
  # pre-commit has already fetched devkit at the rev below, so the version is written down
  # here instead of depending on a variable in whoever's shell, and a second machine that
  # has never cloned devkit is still gated.
  - repo: https://github.com/{{ github_owner }}/devkit
    rev: {{ devkit_ref }}
    hooks:
      # Fails on a manifest the harness would otherwise ignore: unparseable TOML (the
      # loader falls back to neutral defaults rather than erroring), a path prefix missing
      # its trailing slash, a directory that does not exist here, or a [db]/[frontend]
      # block switched on and left half-filled.
      - id: devkit-manifest
      # The vendored hook scripts run before the virtualenv exists, so a third-party
      # import there fails at hook time rather than at test time.
      - id: devkit-hooks-stdlib-only
      # Byte-compares scripts/hooks/ and friends against the devkit rev pinned above.
      - id: devkit-drift
      # The pre-push stage: the PR gate's own commands, before the push leaves.
      - id: devkit-push-gate

  # --- formatting and lint ----------------------------------------------------
  # The same fixers the `lint-fix.py` PostToolUse hook applies after every agent edit, so
  # a human commit and an agent commit converge instead of reformatting each other.
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.16.0
    hooks:
      - id: ruff-check
        args: [--fix]
      - id: ruff-format

  # The workflow linter. Here rather than in `scripts/lint-all.py`, which degrades a
  # missing binary to a note: pre-commit builds the tool itself from the pinned rev, so
  # a workstation that never ran the CI installer still checks its workflows.
  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint

  # --- hygiene ----------------------------------------------------------------
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      # Fixers, not readability rules — and not cosmetic for a repo with a vendored
      # harness: a trailing space in a vendored file becomes drift the first time an
      # editor strips it, and `sync-devkit.py --check` then fails a build over a byte
      # nobody meant to change.
      #
      # `stages: [pre-commit]` on three of them: their upstream manifest names every
      # stage, which overrides `default_stages` above, and a fixer over the whole tree
      # at push time rewrites files during a push.
      - id: trailing-whitespace
        stages: [pre-commit]
      - id: end-of-file-fixer
        stages: [pre-commit]
      - id: mixed-line-ending
        args: [--fix=lf] # matches .gitattributes' `eol=lf`
      - id: check-merge-conflict
      - id: check-yaml
      - id: check-toml
      - id: check-json
        # .claude/settings.json is strict JSON; .vscode/tasks.json is JSONC and would fail.
        files: ^\.claude/settings\.json$
      - id: check-added-large-files
        stages: [pre-commit]

  # --- secrets ----------------------------------------------------------------
  # This is the hook `scripts/hooks/stop.py` defers to when it passes `--no-secrets`:
  # secrets scanning belongs at commit time, not on every agent turn, where it would churn
  # the baseline and cost seconds per stop.
  - repo: https://github.com/Yelp/detect-secrets
    rev: v1.5.0
    hooks:
      - id: detect-secrets
        # NB if you ever pin a devkit *commit* above instead of a tag, add
        # `# pragma: allowlist secret` to that line — a 40-char hex SHA trips the
        # high-entropy detector. `pre-commit autoupdate` writes tags, so this is only a
        # concern if you pin by hand.
        #
        # No `--baseline`: findings are allowlisted inline with
        # `# pragma: allowlist secret`, which is what this project's committed local-dev
        # compose credentials already use. Add a baseline file only once the pragma count
        # gets annoying — it is one more artifact to keep in sync, and a stale one hides
        # real findings.
        exclude: |
          (?x)^(
            uv\.lock|            # generated hashes, indistinguishable from secrets
            \.env\.example|      # placeholder values, by definition not real
            DEVKIT_FILES\.json   # vendoring receipt: path -> SHA-256, all of it hex
          )$
