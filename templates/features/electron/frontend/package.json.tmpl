{
  "name": "{{ package }}",
  "productName": "{{ display_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:e2e": "electron-vite build && playwright test --project=source",
    "test:e2e:packaged": "electron-vite build && electron-builder --dir && playwright test --project=packaged",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
