# What `dotnet format` enforces, and what an editor applies on save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,targets,slnx,json,yml,yaml,toml,md}]
indent_size = 2

[*.cs]
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
