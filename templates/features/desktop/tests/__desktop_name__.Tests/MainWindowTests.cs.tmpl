using System.Diagnostics;
using System.IO;
using System.Windows;
using System.Windows.Media;
using System.Windows.Media.Imaging;
using System.Windows.Threading;
using Xunit;

namespace {{ desktop_name }}.Tests;

/// <summary>
/// The failures a build cannot see. A broken `{Binding}` compiles, runs and draws nothing,
/// reporting only to a debugger, and App.xaml's resources are resolved at launch. Each new
/// window gets a test like the first one here.
/// </summary>
public class MainWindowTests
{
    private static readonly TimeSpan Patience = TimeSpan.FromSeconds(30);

    [Fact]
    public void TheWindowDrawsWithNoBrokenBinding()
    {
        var errors = RunOnUiThread(() =>
        {
            using var bindings = new BindingErrors();
            var window = new MainWindow
            {
                // Off-screen and unfocused: the suite runs on a machine someone is using.
                WindowStartupLocation = WindowStartupLocation.Manual,
                Left = -32000,
                Top = -32000,
                ShowActivated = false,
                ShowInTaskbar = false,
            };
            window.Show();
            // Bindings resolve at layout: let it finish before reading what they said.
            window.Dispatcher.Invoke(() => { }, DispatcherPriority.ApplicationIdle);
            Screenshot((FrameworkElement)window.Content, ScreenshotPath("main-window.png"));
            window.Close();
            return bindings.Seen;
        });

        Assert.Empty(errors);
    }

    [Fact]
    public void TheAppStartsAndClosesCleanly()
    {
        var exe = Path.Combine(AppContext.BaseDirectory, $"{AppInfo.Name}.exe");
        using var app = Process.Start(exe);
        try
        {
            Assert.True(WaitForWindow(app), $"no window after {Patience}; see the app's own crash");
            Assert.Equal(AppInfo.Name, app.MainWindowTitle);
            Assert.True(app.CloseMainWindow());
            Assert.True(app.WaitForExit(Patience), "the window closed and the process stayed");
            Assert.Equal(0, app.ExitCode);
        }
        finally
        {
            if (!app.HasExited)
            {
                app.Kill();
            }
        }
    }

    private static bool WaitForWindow(Process app)
    {
        var deadline = DateTime.UtcNow + Patience;
        while (DateTime.UtcNow < deadline && !app.HasExited)
        {
            app.Refresh();
            if (app.MainWindowHandle != IntPtr.Zero)
            {
                return true;
            }

            Thread.Sleep(100);
        }

        return false;
    }

    /// <summary>`logs/ui/` of this checkout, the file an agent reads after a UI change.</summary>
    private static string ScreenshotPath(string name)
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, ".devkit.toml")))
        {
            directory = directory.Parent;
        }

        var root = directory?.FullName ?? AppContext.BaseDirectory;
        return Path.Combine(root, "logs", "ui", name);
    }

    /// <summary>The window's content on its background, whatever its fade has reached.</summary>
    private static void Screenshot(FrameworkElement content, string path)
    {
        var width = (int)Math.Ceiling(content.ActualWidth);
        var height = (int)Math.Ceiling(content.ActualHeight);
        var picture = new DrawingVisual();
        using (var canvas = picture.RenderOpen())
        {
            var bounds = new Rect(0, 0, width, height);
            canvas.DrawRectangle(SystemColors.WindowBrush, null, bounds);
            canvas.DrawRectangle(new VisualBrush(content), null, bounds);
        }

        var bitmap = new RenderTargetBitmap(width, height, 96, 96, PixelFormats.Pbgra32);
        bitmap.Render(picture);
        var encoder = new PngBitmapEncoder();
        encoder.Frames.Add(BitmapFrame.Create(bitmap));
        Directory.CreateDirectory(Path.GetDirectoryName(path)!);
        using var file = File.Create(path);
        encoder.Save(file);
    }

    /// <summary>WPF insists on an STA thread, and xUnit's are not.</summary>
    private static T RunOnUiThread<T>(Func<T> body)
    {
        T? result = default;
        Exception? failure = null;
        var thread = new Thread(() =>
        {
            try
            {
                result = body();
            }
            catch (Exception exception)
            {
                failure = exception;
            }
            finally
            {
                Dispatcher.CurrentDispatcher.InvokeShutdown();
            }
        });
        thread.SetApartmentState(ApartmentState.STA);
        thread.Start();
        thread.Join();
        if (failure is not null)
        {
            throw new InvalidOperationException("the window failed on its UI thread", failure);
        }

        return result!;
    }

    /// <summary>
    /// WPF's own binding diagnostics, which trace only under a debugger until `Refresh`
    /// turns them on. Warning is the level a failed binding reports at.
    /// </summary>
    private sealed class BindingErrors : TraceListener
    {
        private readonly List<string> _seen = [];

        public BindingErrors()
        {
            PresentationTraceSources.Refresh();
            PresentationTraceSources.DataBindingSource.Switch.Level = SourceLevels.Warning;
            PresentationTraceSources.DataBindingSource.Listeners.Add(this);
        }

        public IReadOnlyList<string> Seen => _seen;

        public override void Write(string? message)
        {
        }

        public override void WriteLine(string? message)
        {
            if (!string.IsNullOrWhiteSpace(message))
            {
                _seen.Add(message);
            }
        }

        protected override void Dispose(bool disposing)
        {
            PresentationTraceSources.DataBindingSource.Listeners.Remove(this);
            base.Dispose(disposing);
        }
    }
}
