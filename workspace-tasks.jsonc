				"--end",
				"${input:oosEnd}"
			],
			"icon": {
				"id": "graph",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		// --- scoped: the checkouts that have a database -----------------------
		{
			// The last task to leave a .vscode/tasks.json anywhere, and the only one
			// that lived in the GENERATOR template rather than a live repo. Its
			// picker spans four checkouts rather than two because two separate repos
			// have an Alembic tree; devkit is absent because it has no database.
			"label": "DB: New Migration (Autogenerate)",
			"detail": "Run `alembic revision --autogenerate` sequentially in each selected database checkout. ALWAYS READ EVERY GENERATED FILE before committing. It never runs `upgrade`, but each database must be up and current.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:dbCheckout}",
				"db-revision",
				"-m",
				"${input:migrationMessage}"
			],
			"icon": {
				"id": "database",
				"color": "terminal.ansiBrightRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- workspace-scoped: act across every checkout ---------------------
		{
			"label": "Project: New from devkit",
			"detail": "Scaffold a whole new project — templates, Docker stack on registry-allocated ports, vendored devkit harness, parallel worktree, PR gate, and a PRIVATE GitHub repo. Registers it in this workspace's folder list and project picker. DRY RUN by default: pick 'Apply' to actually write.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Project: New from devkit",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Project: New from devkit",
				"--",
				"python",
				"scripts/new-project.py",
				"${input:newProjectName}",
				"--preset",
				"${input:newProjectPreset}",
				"--description",
				"${input:newProjectDescription}",
				"${input:newProjectRemote}",
				"${input:newProjectApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "new-folder",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"clear": true,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Devkit: Upgrade Projects",
			"detail": "DRY RUN by default. Adopt the current devkit release in each selected consumer, one PR per repo. Skips duplicate worktree siblings and refuses dirty or unvendored explicit targets; one refusal does not stop the rest.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Devkit: Upgrade Projects",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Devkit: Upgrade Projects",
				"--",
				"python",
				"scripts/upgrade-project.py",
				"${input:upgradeScope}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "package",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- the ephemeral tier: a box per task, destroyed when the work leaves it ---
		//
		// Deliberately three tasks and not four: there is no "reap one box" entry,
		// because a picker cannot enumerate boxes that are created between clicks.
		// Reaping by name is the CLI (`worktree.py reap <box> --yes`), and the one-click
		// shape is the sweep, which steps over every box still holding work.
		{
			"label": "Worktree: New Box",
			"detail": "Cut a disposable worktree for one task: a fresh claude/… branch off origin/<default>, its own port-slot lease and COMPOSE_PROJECT_NAME, and its toolchain installed (uv sync / pip locks / npm, whichever the project uses — a cold install can take minutes). Leave the topic blank to name it after the project. DRY RUN by default.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Worktree: New Box",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Worktree: New Box",
				"--",
				"python",
				"scripts/worktree.py",
				"new",
				"${input:worktreeProject}",
				"--slug",
				"${input:worktreeSlug}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "repo-forked",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Worktree: List Boxes — read-only",
			"detail": "Every live box, its branch, its port slot, and whether its work has left it yet. Boxes are absent from this workspace's folder list by design, so nothing else reports them — a forgotten one holds a slot out of a fixed ceiling and, if its project has a stack, a container and volume set. Touches nothing.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Worktree: List Boxes",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Worktree: List Boxes",
				"--",
				"python",
				"scripts/worktree.py",
				"list",
				"${input:sweepFetch}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "list-tree",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Worktree: Reap Finished Boxes",
			"detail": "DRY RUN by default. For every box whose work has left it: tear its stack down (containers, network and its own volumes), remove the worktree, delete the branch, release the port lease. REFUSES any box still holding unshipped work and names it instead — so nothing can be stranded — and never forces, whatever the answer.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Worktree: Reap Finished Boxes",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Worktree: Reap Finished Boxes",
				"--",
				"python",
				"scripts/worktree.py",
				"reap",
				"--all",
				"${input:sweepFetch}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "trash",
				"color": "terminal.ansiBrightRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Worktree: Reconcile — merge, reap, reclaim disk",
			"detail": "DRY RUN by default. The unattended pass a schedule runs: reap every box whose PR has MERGED, reap unused boxes, and — when free space is at or under the floor — reap boxes whose PR is merely open (the remote holds every commit, so only the checkout is lost). NEVER touches a box holding unshipped work; it names those instead. Merging is off unless you pick it.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Worktree: Reconcile",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Worktree: Reconcile",
				"--",
				"python",
				"scripts/worktree.py",
				"reconcile",
				"${input:reconcileMerge}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "git-merge",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ports: Show Checkout Allocations",
			"detail": "Print the *_HOST_PORT block for each selected checkout. Use it to rebuild .env files after worktree changes rather than picking free-looking numbers.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/log-wrap.py",
				"Ports: Show Checkout Allocations",
				"--",
				"python",
				"scripts/devkit_ports.py",
				"${input:project}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "plug",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Agents: Open Tabs (External Terminal)",
			"detail": "Choose Claude or Codex, then open a new Windows Terminal window with one tab per worktree. Machine-scoped, so it takes no project. The Carameli tabs also mount ../VanillaLand as writable.",
			"type": "process",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder:devkit}/scripts/launch-agent-tabs.ps1",
				"-Agent",
				"${input:agentCli}"
			],
			"icon": {
				"id": "rocket",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"clear": true,
				"close": true
			},
			"problemMatcher": []
		},
		{
			// The one agent task that takes NO checkout, and deliberately so. Every
			// picker in this file lists the static checkouts; a session that ran in an
			// ephemeral box is unreachable from all of them, because boxes are absent
			// from `folders` by design. What you want back is the last few sessions
			// wherever they happened, so the script reads the transcript store — which
			// records each session's own directory — instead of asking.
			"label": "Agents: Resume Recent Sessions",
			"detail": "Choose Claude or Codex and how many sessions, then reopen that agent's most recently active sessions in a new Windows Terminal window, one tab each, OLDEST TAB FIRST. Scope-blind: no project picker, so it reaches sessions run in an ephemeral box too. Claude subagent transcripts and sessions whose directory has been reaped are skipped and named. Resuming a session that is still open elsewhere gives you a second window on it.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/resume-sessions.py",
				"--agent",
				"${input:agentCli}",
				"--count",
				"${input:resumeSessionCount}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "history",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			// MAINTAINED BY new-project.py. Command inputs must return one string, so
			// the extension joins checked names with commas. devkit_project.py splits
			// that value, validates every checkout up front, then runs sequentially.
			"id": "project",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which checkout(s) should run this task?",
				"key": "projects",
				"multiPick": true,
				"multiPickStorage": "workspace",
				"separator": ",",
				"optionGroups": [
					{
						"label": "Select one or more checkouts",
						"minCount": 1,
						"options": [
							"carameli",
							"ibkr_trader",
							"devkit",
							"data-lake",
							"apt-finder",
							"sports_betting"
						]
					}
				]
			}
		},
		{
			// The daemon restart/fix actions are machine-scoped. Running either once
			// per checked project would restart the same Docker Desktop repeatedly.
			"id": "daemonProject",
			"type": "pickString",
			"description": "Which checkout should supply the Docker override?",
			"options": [
				"carameli",
				"ibkr_trader",
				"devkit",
				"data-lake",
				"apt-finder",
				"sports_betting"
			],
			"default": "carameli"
		},
		{
			// Which repo a box is cut FROM. Single-pick, like daemonProject: a box
			// belongs to exactly one checkout, and `worktree.py new` takes one name.
			// register() maintains this list along with the other pickers, so a newly
			// generated project can be boxed the day it exists.
			"id": "worktreeProject",
			"type": "pickString",
			"description": "Which repo should the box be cut from?",
			"options": [
				"carameli",
				"ibkr_trader",
				"devkit",
				"data-lake",
				"apt-finder",
				"sports_betting"
			],
			"default": "carameli"
		},
		{
			// The branch topic, so the box is named after the work rather than after
			// the session that asked for it. Safe to leave blank -- it is the value of
			// `--slug`, which consumes it whatever it is, and worktree.py falls back to
			// the project name. That is why it is spelled as a flag here and not as a
			// bare positional, which an empty answer would turn into a stray argument.
			"id": "worktreeSlug",
			"type": "promptString",
			"description": "Topic for the branch name (blank = name it after the project)",
			"default": ""
		},
		{
			// Every project's run-tests.py accepts both of these, which is what lets
			// this be a picker rather than a free-text box. `--changed` is the
			// canonical spelling everywhere — devkit, the template, and the vendored
			// Stop hook's own remediation line. carameli used to spell it `--fast`,
			// which meant the Stop hook's advice died on "Unknown argument"; it now
			// accepts `--changed` and keeps `--fast` as a deprecated alias.
			//
			// The empty value is safe HERE specifically: devkit_project.py drops empty
			// arguments before exec, so it cannot reach argparse as a stray positional
			// (tests/test_devkit_project.py pins that). A picker feeding a script
			// directly still needs one real token per branch.
			"id": "testScope",
			"type": "pickString",
			"description": "How much of the suite to run",
			"options": [
				{
					"label": "Full suite (default)",
					"value": ""
				},
				{
					"label": "Changed only — the working-tree diff",
					"value": "--changed"
				}
			],
			"default": ""
		},
		{
			// The one picker in this file where an accidental Enter spends money, so the
			// default is the smallest run that still proves something rather than the most
			// thorough one. Single-pick for the same reason: "both" is a deliberate choice,
			// not two checkboxes that are easy to leave ticked from last time.
			"id": "liveHookSuite",
			"type": "pickString",
			"description": "Which live CLI smoke? Every option launches a paid session.",
			"options": [
				{
					"label": "Claude only — cheapest, one session",
					"value": "claude"
				},
				{
					"label": "Codex only — two sessions",
					"value": "codex"
				},
				{
					"label": "Both — every live smoke",
					"value": "both"
				}
			],
			"default": "claude"
		},
		{
			// The two-option pickers for the project-SCOPED tasks. Deliberately not
			// the `project` picker above: three of the five checkouts it lists cannot
			// run a Playwright suite, and offering them would make the wrong answer
			// available at exactly the moment you are least likely to notice. The
			// dispatcher validates the same restriction from its side
			// (`Action.projects`), so these lists are UX, never the guarantee.
			//
			// The extension remembers checked items per workspace. The dispatcher
			// still validates the action's scope before starting either checkout.
			"id": "carameliCheckout",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which Carameli checkout(s) should run this task?",
				"key": "carameliCheckouts",
				"multiPick": true,
				"multiPickStorage": "workspace",
				"separator": ",",
				"optionGroups": [
					{
						"label": "Select the checkout",
						"minCount": 1,
						"options": ["carameli"]
					}
				]
			}
		},
		{
			"id": "ibkrCheckout",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which IBKR Trader checkout(s) should run this task?",
				"key": "ibkrCheckouts",
				"multiPick": true,
				"multiPickStorage": "workspace",
				"separator": ",",
				"optionGroups": [
					{
						"label": "Select the checkout",
						"minCount": 1,
						"options": ["ibkr_trader"]
					}
				]
			}
		},
		{
			// Four options, not two: `db-revision` is the one scoped action that
			// spans two repos, because both have an Alembic tree. devkit is absent
			// because it has no database (`[db] enabled = false`), and it is absent
			// from `DB_PROJECTS` for the same reason — the two lists have to agree,
			// and a test asserts they do.
			"id": "dbCheckout",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which checkout(s) should generate this migration?",
				"key": "dbCheckouts",
				"multiPick": true,
				"multiPickStorage": "workspace",
				"separator": ",",
				"optionGroups": [
					{
						"label": "Select one or more database checkouts",
						"minCount": 1,
						"options": [
							"carameli",
							"ibkr_trader"
						]
					}
				]
			}
		},
		{
			// Free text, and it reaches a shell inside carameli's app container (the
			// PgBouncer bypass needs `sh -c` to expand $DIRECT_DATABASE_URL), so that
			// script quotes it. ibkr_trader's passes it as its own argv element and
			// never involves a shell at all.
			"id": "migrationMessage",
			"type": "promptString",
			"description": "Short description of the schema change (becomes part of the migration filename)",
			"default": ""
		},
		{
			// `hook-tests` is absent: it is the workspace's own "Test: Harness Hook
			// Tests" now, identical in every consumer, and a second spelling of it
			// here would be a third copy of the same run.
			"id": "carameliTestTarget",
			"type": "pickString",
			"description": "Which Carameli-only free target to run",
			"options": [
				{
					"label": "All free targets (pytest + hooks + frontend + bundle budgets), one merged artifact",
					"value": "--all"
				},
				{
					"label": "Frontend (Vitest)",
					"value": "--target=frontend-tests"
				},
				{
					// Builds the frontend, then measures what the build produced
					// against frontend/bundlePolicy.ts. Separate from the Vitest
					// entry above because `test:run` never builds and so can never
					// reach those budgets.
					"label": "Frontend bundle budgets (production build + Vitest)",
					"value": "--target=bundle-budgets"
				},
				{
					"label": "Public webhook reachability",
					"value": "--target=webhook-e2e"
				}
			],
			"default": "--all"
		},
		{
			// Carries an empty branch, and is safe for the same reason `testScope`
			// is: it feeds `devkit_project.py`, which drops empty arguments before
			// exec. While this picker lived in carameli's own task file it fed
			// `run-e2e.py` directly and survived only because that script happens to
			// test membership rather than parse arguments — an accident, and one of
			// the things hoisting these actually FIXED.
			"id": "e2eMode",
			"type": "pickString",
			"description": "Which Playwright mode to run",
			"options": [
				{
					"label": "Headless (default)",
					"value": ""
				},
				{
					"label": "Headed — watch the browser",
					"value": "--headed"
				},
				{
					"label": "Cross-browser — Chromium, Firefox, WebKit",
					"value": "--cross-browser"
				}
			],
			"default": ""
		},
		{
			"id": "ingestSource",
			"type": "pickString",
			"description": "Which data source to pull",
			"options": [
				{ "label": "FMP prices — batch", "value": "fmp-prices-batch" },
				{ "label": "FMP prices — one symbol", "value": "fmp-price-one" },
				{ "label": "Yahoo prices — batch", "value": "yahoo-prices-batch" },
				{ "label": "Yahoo fundamentals — batch", "value": "yahoo-fundamentals-batch" },
				{ "label": "Alpha Vantage prices — batch", "value": "alpha-vantage-batch" },
				{ "label": "Finnhub news — batch", "value": "finnhub-news-batch" },
				{ "label": "Finnhub news — one symbol", "value": "finnhub-news-one" },
				{ "label": "NewsAPI headlines — batch", "value": "newsapi-batch" },
				{ "label": "Google Trends — batch", "value": "trends-batch" },
				{ "label": "Google Trends — one keyword", "value": "trends-one" },
				{ "label": "Reddit", "value": "reddit" },
				{ "label": "FMP FX — one pair", "value": "fmp-fx" },
				{ "label": "Yahoo FX — deep-history backfill", "value": "yahoo-fx-backfill" }
			],
			"default": "fmp-prices-batch"
		},
		{
			// Consumed as `--arg=${input:ingestArg}`, one token, NOT as a separate
			// `--arg` flag followed by this value. An empty answer is the common case
			// (ten of the thirteen sources ignore it), and as two tokens the empty one
			// is dropped in transit, leaving a dangling `--arg` for argparse to
			// misread. `--arg=` with nothing after it is unambiguous.
			"id": "ingestArg",
			"type": "promptString",
			"description": "Optional symbol, keyword, or FX pair for single-item modes",
			"default": ""
		},
		{
			// Every branch supplies one real token — `--full` is redundant against
			// the script's own default and exists for exactly that reason.
			"id": "snapshotScope",
			"type": "pickString",
			"description": "Full ritual, or re-run just the snapshot over data already ingested?",
			"options": [
				{
					"label": "Full ritual — migrations, prices, aggregation, snapshot",
					"value": "--full"
				},
				{
					"label": "Snapshot only — skip the price ingests",
					"value": "--skip-ingest"
				},
				{
					"label": "Dry run — print the plan, run nothing",
					"value": "--dry-run"
				}
			],
			"default": "--full"
		},
		{
			"id": "btStrategy",
			"type": "pickString",
			"description": "Allocator to simulate",
			"options": [
				"ml_lt_ridge",
				"ml_lt",
				"momentum_lt",
				"equal_weight",
				"buy_and_hold"
			],
			"default": "ml_lt_ridge"
		},
		{
			// Shared by both Backtest tasks — the account is the one input the OOS
			// run still takes, since which account you evaluate does not affect
			// whether two OOS runs are comparable.
			"id": "btAccount",
			"type": "pickString",
			"description": "Registered account to simulate",
			"options": [
				"tfsa",
				"rrsp",
				"fhsa",
				"lira",
				"nonreg"
			],
			"default": "tfsa"
		},
		{
			"id": "btUniverseFile",
			"type": "pickString",
			"description": "Universe file",
			"options": [
				{ "label": "tickers-etfs.txt — ETF floor", "value": "tickers-etfs.txt" },
				{ "label": "tickers.txt — stocks + ETFs", "value": "tickers.txt" }
			],
			"default": "tickers-etfs.txt"
		},
		{
			"id": "btStart",
			"type": "promptString",
			"description": "Bar-load start",
			"default": "2008-06-02"
		},
		{
			"id": "btEvalStart",
			"type": "promptString",
			"description": "First decision date",
			"default": "2010-01-04"
		},
		{
			"id": "btEnd",
			"type": "promptString",
			"description": "Window end",
			"default": "2030-01-01"
		},
		{
			"id": "oosEnd",
			"type": "promptString",
			"description": "OOS dataset window end",
			"default": "2026-07-01"
		},
		{
			// Every branch supplies one real token — `--check` rather than "" for
			// the default — for the reason spelled out on `newProjectRemote` below.
			"id": "harnessMode",
			"type": "pickString",
			"description": "Drift-check, adopt upstream, or push a change authored here",
			"options": [
				{
					"label": "Check for drift (safe, read-only)",
					"value": "--check"
				},
				{
					"label": "Pull — adopt devkit's version, overwriting local",
					"value": "--pull"
				},
				{
					"label": "Push — send this repo's version up to devkit",
					"value": "--push"
				},
				{
					"label": "List the manifest + vendored version",
					"value": "--list"
				}
			],
			"default": "--check"
		},
		{
			"id": "newProjectName",
			"type": "promptString",
			"description": "New project name — becomes the directory, the Python package, and COMPOSE_PROJECT_NAME",
			"default": ""
		},
		{
			"id": "newProjectPreset",
			"type": "pickString",
			"description": "Project shape. Individual features can be added later with --with-* flags.",
			"options": [
				{
					"label": "service — Docker + app + Postgres + Alembic",
					"value": "service"
				},
				{
					"label": "service-redis — the above plus Redis",
					"value": "service-redis"
				},
				{
					"label": "data — Postgres + the data-lake archive seam (ibkr_trader's shape)",
					"value": "data"
				},
				{
					"label": "fullstack — service-redis plus a Vite frontend (carameli's shape)",
					"value": "fullstack"
				},
				{
					"label": "bare — no Docker, no database; just the harness and CI",
					"value": "bare"
				}
			],
			"default": "service"
		},
		{
			"id": "newProjectDescription",
			"type": "promptString",
			"description": "One-line description (goes into README.md, CLAUDE.md, and pyproject.toml)",
			"default": ""
		},
		{
			// Both pickers supply one real token in every branch, never "". An empty
			// string in an args array reaches argparse as a stray positional and is
			// rejected — which is why new-project.py carries the redundant-looking
			// `--dry-run` and `--remote` flags alongside their negations.
			"id": "newProjectRemote",
			"type": "pickString",
			"description": "Create a PRIVATE GitHub repo and push? (ignored on a dry run)",
			"options": [
				{
					"label": "Yes — create alexandrec90/<name> as private, and push",
					"value": "--remote"
				},
				{
					"label": "No — local only, wire up the remote later",
					"value": "--no-remote"
				}
			],
			"default": "--remote"
		},
		{
			"id": "newProjectApply",
			"type": "pickString",
			"description": "Dry run prints the full plan and writes nothing. Run it once before applying.",
			"options": [
				{
					"label": "Dry run — print the plan, write nothing",
					"value": "--dry-run"
				},
				{
					"label": "Apply — write files, init git, add the worktree",
					"value": "--yes"
				}
			],
			"default": "--dry-run"
		},
		{
			"id": "sweepFetch",
			"type": "pickString",
			"description": "Fetch every remote first?",
			"options": [
				{
					"label": "Fetch — accurate ahead/behind counts (slower)",
					"value": "--fetch"
				},
				{
					"label": "Skip fetch — instant, counts may be stale",
					"value": "--no-fetch"
				}
			],
			"default": "--fetch"
		},
		{
			// Separate from `project` because devkit is absent on purpose: it is the
			// source the release is pulled *from*, and naming it is rejected — that
			// exclusion is written down in `SCOPE_PICKERS` in tests/test_devkit_project.py,
			// which otherwise requires this list to cover every checkout. Being listed
			// here is not a claim that a project has vendored devkit; an explicitly
			// selected checkout that has not is refused by name.
			"id": "upgradeScope",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which checkouts should adopt the devkit release?",
				"key": "upgradeScope",
				"multiPick": true,
				"multiPickStorage": "workspace",
				"separator": ",",
				"optionGroups": [
					{
						"label": "Select one or more consumers (devkit is the source)",
						"minCount": 1,
						"options": [
							"carameli",
							"ibkr_trader",
							"data-lake",
							"apt-finder",
							"sports_betting"
						]
					}
				]
			}
		},
		{
			"id": "reconcileMerge",
			"type": "pickString",
			"description": "Merge green PRs, or only clean up?",
			"options": [
				{
					"label": "Clean up only — merging PRs stays yours",
					"value": "--no-merge"
				},
				{
					"label": "Also squash-merge every PR whose gate is green",
					"value": "--merge"
				}
			],
			"default": "--no-merge"
		},
		{
			"id": "sweepApply",
			"type": "pickString",
			"description": "Dry run, or actually change the checkouts?",
			"options": [
				{
					"label": "Dry run — print the plan, change nothing",
					"value": "--dry-run"
				},
				{
					"label": "Apply — run the git commands shown",
					"value": "--yes"
				}
			],
			"default": "--dry-run"
		},
		{
			"id": "agentCli",
			"type": "pickString",
			"description": "Coding agent CLI to open in every worktree tab",
			"options": [
				"claude",
				"codex"
			],
			"default": "claude"
		},
		{
			"id": "resumeSessionCount",
			"type": "promptString",
			"description": "How many of the most recently active sessions to reopen",
			"default": "4"
		},
		{
			// MAINTAINED BY new-project.py, like `project` — and it is the only
			// picker that lists MORE than the registry, because the reference
			// checkout can take this action and no other. Single-pick: a merge
			// conflict is resolved per repo, so batching them would just queue up
			// two half-finished merges.
			"id": "mergeCheckout",
			"type": "pickString",
			"description": "Which checkout should take origin's default branch?",
			"options": [
				"VanillaLand",
				"carameli",
				"ibkr_trader",
				"devkit",
				"data-lake",
				"apt-finder",
				"sports_betting"
			],
			"default": "VanillaLand"
		},
		{
			// Every branch supplies one real token — `auto` rather than "" — for the
			// reason spelled out on `newProjectRemote`. `auto` reads the branch off
			// refs/remotes/origin/HEAD, which is already `develop` in VanillaLand;
			// the named ones are for merging from somewhere other than the trunk.
			"id": "mergeBase",
			"type": "pickString",
			"description": "Which branch to merge FROM",
			"options": [
				{
					"label": "Auto — origin's own default branch",
					"value": "auto"
				},
				{
					"label": "develop",
					"value": "develop"
				},
				{
					"label": "main",
					"value": "main"
				},
				{
					"label": "master",
					"value": "master"
				}
			],
			"default": "auto"
		},
		{
			// The dropdown pair this task asks with. The extension cannot RUN anything to
			// build a list, so both read the option file `preview-task.py` writes under
			// devkit's `logs/` on every run — which makes the list the PREVIOUS scan. Every
			// checkout's rows therefore end in a `Rescan` row that says so, and picking it
			// rescans and falls through to the terminal menu. `Preview: Restart Standing
			// Previews` asks nothing and writes the same file, so it is the way to bootstrap
			// one on a machine that has never run either task.
			//
			// `previewProject` is NESTED inside this input rather than declared beside it,
			// because the second list depends on the first: the extension resolves a nested
			// `pickStringRemember` first and substitutes the answer into the expressions
			// below. Two sibling inputs would resolve in whatever order VS Code chose, and
			// neither could read the other.
			//
			// The pick fires ONCE, in `value`: the extension substitutes each template
			// string in turn, and EVERY `${pickStringRemember:...}` occurrence opens its
			// own quick-pick — spelled in all four fields, the project dropdown appeared
			// four times per run. `value` resolves first, the pick stores its answer under
			// its `key`, and the other three fields read it back with
			// `${remember:previewProject}`, which never prompts.
			//
			// The value is one token, `<project>:<ref>`, because a VS Code input resolves to
			// one string. `git check-ref-format` refuses a ref containing a colon, so the
			// first one always separates the two halves.
			"id": "previewRow",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Which branch, PR or box should be brought up?",
				"key": "previewRow",
				"fileName": "${workspaceFolder:devkit}/logs/preview-menu.json",
				"fileFormat": "json",
				"jsonOption": {
					"value": "content.rows['${pickStringRemember:previewProject}'][__itemIdx__].value",
					"label": "content.rows['${remember:previewProject}'][__itemIdx__].label",
					"description": "content.rows['${remember:previewProject}'][__itemIdx__].description",
					"detail": "content.rows['${remember:previewProject}'][__itemIdx__].detail"
				},
				"pickStringRemember": {
					"previewProject": {
						"description": "Which checkout has the branch you want to look at?",
						"key": "previewProject",
						"fileName": "${workspaceFolder:devkit}/logs/preview-menu.json",
						"fileFormat": "json",
						"jsonOption": {
							"value": "content.projects[__itemIdx__].name",
							"label": "content.projects[__itemIdx__].label",
							"description": "content.projects[__itemIdx__].description"
						}
					}
				}
			}
		}
	]
}
