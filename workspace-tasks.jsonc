// Canonical shared task block — devkit owns this; alex-projects.code-workspace
// carries a copy under its "tasks" key. Edit the workspace file, then adopt the
// change here:
//
//     python scripts/devkit_project.py --adopt-tasks
//
// and verify with `--check-tasks`. The workspace file is not inside any repo, so it
// cannot be vendored the way sync-devkit.py's MANIFEST files are; this pairing is the
// drift check that replaces that. Comparison is semantic (parsed), not byte-for-byte.
{
	"version": "2.0.0",
	"tasks": [
		// --- generic: pick a project ---------------------------------------
		{
			"label": "Test: Run Suite",
			"detail": "Each selected checkout's own test suite, run sequentially via its scripts/run-tests.py. Failures go to that checkout's logs/test-failures.log — read the artifact, not the terminal.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"test",
				"${input:testScope}"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"icon": {
				"id": "beaker",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Harness Hook Tests — free",
			"detail": "The vendored tier's own stdlib-only tests in each selected checkout, run sequentially. Separate from 'Test: Run Suite' because pytest's testpaths deliberately excludes scripts/hooks/tests/ in EVERY consumer. Fails loudly on a checkout that does not vendor the harness.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"test-hooks"
			],
			"group": "test",
			// Not `beaker`/green: that is "Test: Run Suite", and the two sat
			// side by side in the picker as an identical icon under two labels.
			"icon": {
				"id": "zap",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Harness Hook Tests — paid, live CLI",
			"detail": "PAID — launches a real authenticated agent CLI against a throwaway project and proves the hooks change what it actually does. devkit only: these smokes live in tests/, which is never vendored. 'Claude only' is the cheapest run; each suite's model and budget are set in its own test file. Failures go to devkit/logs/hook-test-live-failures.log.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				// Written out rather than a picker: the action's scope is one checkout, so a
				// picker here would be a list of length one asking a question with no second
				// answer. `test_the_live_smoke_task_names_the_only_checkout_that_can_run_it`
				// pins this literal against `Action.projects` so the two cannot drift.
				"devkit",
				"test-hooks-live",
				"${input:liveHookSuite}"
			],
			"group": "test",
			// Same `zap` family as the free hook tests, in red: the colour is the only
			// warning a one-click paid task gets before it is clicked.
			"icon": {
				"id": "zap",
				"color": "terminal.ansiRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Lint: Everything",
			"detail": "Full-repo lint for each selected checkout, run sequentially via scripts/lint-all.py. Findings go to that checkout's logs/lint-errors.log.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"lint"
			],
			"group": "build",
			"icon": {
				"id": "checklist",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Lint: Changed Files",
			"detail": "Lint only the working-tree diff (vs HEAD, plus untracked) in each selected checkout. Runs sequentially; same artifact as 'Lint: Everything'.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"lint-changed"
			],
			"group": "build",
			// Same reason as the hook tests above — `checklist`/yellow is
			// "Lint: Everything"; the narrower scope gets the narrower icon.
			"icon": {
				"id": "list-selection",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Agent: Sync Codex Context",
			"detail": "Regenerate Codex repository skills and hook configuration in each selected checkout, sequentially.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-codex"
			],
			"icon": {
				"id": "sync",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Harness: Check Drift vs devkit",
			"detail": "Byte-compares each selected checkout's vendored scripts/hooks/ against devkit, sequentially. Needs DEVKIT_DIR set. Defaults to the read-only check; --pull and --push both rewrite files.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-devkit",
				"${input:harnessMode}"
			],
			"icon": {
				"id": "diff",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Git: Sync Branch onto Origin Default (Keep Changes)",
			"detail": "For each selected checkout, sequentially: detect origin's default branch, then fetch → stash if dirty → rebase → pop. Keeps unstaged/untracked changes.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-branch"
			],
			"icon": {
				"id": "git-merge",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			// The one task that reaches a REFERENCE checkout, and the reason it is
			// not a devkit_project.py dispatch: that dispatcher resolves through
			// `known_projects`, which drops NOT_PROJECTS because every action it
			// runs needs a harness. Merging a trunk in needs git and nothing else,
			// so this script resolves against the raw registry and its picker lists
			// VanillaLand alongside the projects.
			//
			// The sibling above REBASES, which is right for a task branch and wrong
			// for long-lived work whose history is already published. This merges.
			"label": "Git: Merge Origin Default into Current Branch",
			"detail": "Fetch, then MERGE origin's default branch — auto-detected, so `develop` in VanillaLand — into whatever branch the chosen checkout is on. Commits locally and NEVER pushes. On conflict the merge is LEFT IN PROGRESS and every unmerged file is named in devkit's logs/git-merge-origin-default-into-current-branch.log; hand that file to a coding agent.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Git: Merge Origin Default into Current Branch",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Git: Merge Origin Default into Current Branch",
				"--",
				"python",
				"scripts/git-merge-default.py",
				"--checkout",
				"${input:mergeCheckout}",
				"--base",
				"${input:mergeBase}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "git-merge",
				"color": "terminal.ansiBrightCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- generic: Docker ------------------------------------------------
		// Two kinds live here. The first two are STACK-scoped: they act on the
		// chosen project's own compose topology, which genuinely differs (carameli
		// waits on healthchecks, ibkr_trader scopes to its ibkr/app profiles), so
		// they delegate to that project's script and the shared thing is the CLI
		// contract. The rest are DAEMON-scoped — one Docker Desktop per machine —
		// and delegate only so a project can override the teardown.
		{
			"label": "Docker: Start Stack",
			"detail": "Build and start each selected checkout's stack sequentially, then wait for healthchecks. The default build task (Ctrl+Shift+B). A checkout with no Docker tier says so by name.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-up"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"icon": {
				"id": "vm-running",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Stop Stack",
			"detail": "Stop each selected checkout's containers sequentially. Named volumes and their data survive — this is `down`, never `down -v`.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-down"
			],
			"icon": {
				"id": "vm-outline",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Restart Engine",
			"detail": "Unsticks a daemon hung on 'Starting the Docker Engine': kill processes → wsl --shutdown → relaunch → poll until `docker info` answers. Uses the chosen project's own scripts/docker-restart-engine.py when it ships one.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:daemonProject}",
				"docker-restart-engine"
			],
			"icon": {
				"id": "debug-restart",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Fix Stalled Desktop",
			"detail": "The aggressive escalation from 'Restart Engine' — two stop/start rounds and a doubled poll window, for a Docker Desktop that never finishes starting. Uses the chosen project's own scripts/docker-fix.py when it ships one.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:daemonProject}",
				"docker-fix"
			],
			"icon": {
				"id": "tools",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Prune + Compact VHDX",
			"detail": "For each selected checkout sequentially: reclaim image/build-cache space and compact the WSL2 VHDX. Never touches named volumes; project overrides may tear down and restore their own stack.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-prune"
			],
			"icon": {
				"id": "trash",
				"color": "terminal.ansiRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			// Machine scope, not project scope — so no `${input:project}`. The three
			// things that make this laptop slow after a few hours are unrelated to
			// each other and only one of them is Docker's, which is why this is not
			// another mode of "Docker: Prune + Compact VHDX". See ACTIONS["reclaim"].
			"label": "Machine: Reclaim Resources",
			"detail": "Stops every running container (docker stop, never down — named volumes and stopped state survive), deletes RDP traces / WSL crash dumps / pytest scratch / node cache and loose %TEMP% files older than 3 days, then reconciles ephemeral boxes — but only once the disk is clear of the 20 GB floor reconcile reaps open PRs at. Reports commit charge; it cannot free memory.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"devkit",
				"reclaim"
			],
			"icon": {
				"id": "flame",
				"color": "terminal.ansiBrightRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"close": false
			},
			"problemMatcher": []
		},
		{
			// Reviewing a UI change before its PR merges. Machine scope, not project
			// scope — there is one box registry and one port registry on this machine, so
			// the checkout is a dimension inside the ANSWER rather than a scope for the task:
			// `previewProject` asks which one, `previewRow` lists that one's refs. See
			// ACTIONS["preview"].
			//
			// `focus` because the terminal menu is still reachable — the `Rescan` row falls
			// through to it — and without it that answer is typed into whatever had focus
			// when the task was clicked.
			"label": "Preview: Open a UI Branch",
			"detail": "Asks which checkout, then which of its refs — preview boxes already standing, live agent boxes, open PRs, recent agent/ branches on origin — and brings that one's stack up in a box of its own, opening the URL it publishes. Both lists are what the last run found; every checkout ends in a 'Rescan' row that looks again and then asks in the terminal. Cutting a box for the first time builds its images and can take minutes; re-serving one that is already standing takes seconds. A running preview costs CPU until 'Machine: Reclaim Resources' stops it.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"devkit",
				"preview",
				"--pick-ref",
				"${input:previewRow}"
			],
			"icon": {
				"id": "preview",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true,
				"close": false
			},
			"problemMatcher": []
		},
		{
			// The same action with the menu skipped, and deliberately WITHOUT `focus`: after
			// a reboot the answer is always "all of them", so the one task that needs no
			// keyboard is the one that should not take it.
			"label": "Preview: Restart Standing Previews",
			"detail": "Brings every preview box that is already cut back up — the one-click answer after a reboot, when Docker stopped every container while the boxes, their branches and their port leases all survived, so each lands back on the port it had before. Asks nothing; a machine with no preview boxes says so and exits.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"devkit",
				"preview",
				"--all"
			],
			"icon": {
				"id": "debug-restart",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"close": false
			},
			"problemMatcher": []
		},
		// --- scoped: carameli's worktree pair --------------------------------
		// These three came up out of `carameli/.vscode/tasks.json`. The picker lists
		// two checkouts rather than five because that is what the action is defined
		// for — see `Action.projects` in devkit_project.py.
		{
			"label": "Test: Run Carameli Target — free",
			"detail": "Run the chosen free target sequentially in each selected Carameli checkout. '--all' merges pytest + hooks + frontend into one artifact per checkout. Paid tiers remain CLI-only.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"test-target",
				"${input:carameliTestTarget}"
			],
			// Deliberately not `isDefault`: "Test: Run Suite" holds that, and two
			// defaults in one multi-root workspace makes Run Test Task ambiguous.
			// That collision was real while this task lived in the repo.
			"group": "test",
			"icon": {
				"id": "beaker",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Run Browser E2E — free",
			"detail": "Run Playwright sequentially against each selected Carameli checkout. NEEDS each stack and Vite server up first. Failures go to that checkout's logs/e2e-failures.log.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"e2e",
				"${input:e2eMode}"
			],
			"group": "test",
			"icon": {
				"id": "browser",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Run Local Integration E2E — free",
			"detail": "Both directions of the carameli <-> VanillaLand integration: boots local IIS Express + vs-sql via VS_REPO_DIR, runs tests/local_e2e, then the .NET outbound driver. Needs a filled .env.local-e2e (see .env.local-e2e.example); no telephony, no cost.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"local-e2e"
			],
			"group": "test",
			"icon": {
				"id": "plug",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			// This one was deleted from carameli's task file for being a one-line
			// wrapper around a documented script, under the old rule that a
			// PROJECT-level task had to justify its copy. That rule is gone with the
			// files it governed: there is no copy here to drift, so a one-click
			// tunnel-plus-resync costs nothing and the script stays the interface.
			"label": "Start: ngrok + Sync Webhook URLs",
			"detail": "Sequentially open an ngrok tunnel for each selected Carameli checkout, update its webhook environment values, and RECREATE app + worker. This interrupts in-flight work and changes each tunnel URL.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"ngrok"
			],
			"icon": {
				"id": "radio-tower",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- scoped: the reference checkout ----------------------------------
		// The second task to reach VanillaLand, and the second one that cannot be a
		// `devkit_project.py` dispatch: that dispatcher resolves through
		// `known_projects`, which drops NOT_PROJECTS because every action it runs
		// needs a harness. Running a start script the checkout itself ships needs
		// PowerShell and nothing else, so `scripts/vanillaland-e2e.py` resolves
		// against the raw registry the way `git-merge-default.py` does.
		{
			"label": "Start: VanillaLand IIS Express",
			"detail": "Run VanillaLand's own .local/carameli-e2e/start.ps1: the persisted vs-sql container, the local SOAP stand-ins, and both 64-bit IIS Express sites (VoipApi :8085, classic web UI :8022), waiting for each to answer — up to ~3 min on a cold start while .NET JITs. Idempotent: a port already listening is left alone. Needs a machine seeded per that checkout's .local/carameli-e2e/README.md. Stops nothing.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Start: VanillaLand IIS Express",
				"--",
				"python",
				"scripts/log-wrap.py",
				"Start: VanillaLand IIS Express",
				"--",
				"python",
				"scripts/vanillaland-e2e.py"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "server-process",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- scoped: ibkr_trader's worktree pair -----------------------------
		// The five that came up out of `ibkr_trader/.vscode/tasks.json`. Each routes
		// through a `scripts/*.py` in that repo, which is what makes them dispatchable
		// at all — the two Backtest tasks named `.venv\Scripts\ibkr-trader.exe`
		// directly and needed `scripts/backtest-task.py` written before they could
		// move. Note there is no "Docker: Start Stack" story here: that project keeps
		// containers OFF by default, and the generic task says so by name.
		{
			"label": "IBKR: Open Gateway VNC Viewer",
			"detail": "Open one TigerVNC viewer per selected IBKR Trader checkout, sequentially. Each checkout needs its `ibkr` profile up; this task only opens viewers.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"vnc",
				"${env:ProgramFiles}\\TigerVNC\\vncviewer.exe"
			],
			"icon": {
				"id": "device-desktop",
				"color": "terminal.ansiBrightBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ingest: Run Source",
			"detail": "Run the selected source pull sequentially in each selected IBKR Trader checkout. Needs each `db` container up; output goes to that checkout's artifacts/tasks/ingest-*.log.",
