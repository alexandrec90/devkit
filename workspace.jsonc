					"${input:btStart}",
					"--eval-start",
					"${input:btEvalStart}",
					"--end",
					"${input:btEnd}"
				],
				"icon": {
					"id": "graph-line",
					"color": "terminal.ansiBrightBlue"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			{
				"label": "Backtest: OOS (Honest Per-Fold)",
				"detail": "Run walk-forward OOS evaluation sequentially in each selected IBKR Trader checkout. Warm-up and simulation starts remain fixed for comparability; output is separate from 'Backtest: Run'.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:ibkrCheckout}",
					"backtest-oos",
					"--account",
					"${input:btAccount}",
					"--end",
					"${input:oosEnd}"
				],
				"icon": {
					"id": "graph",
					"color": "terminal.ansiBrightMagenta"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			// --- scoped: the checkouts that have a database -----------------------
			{
				// The last task to leave a .vscode/tasks.json anywhere, and the only one
				// that lived in the GENERATOR template rather than a live repo. Its
				// picker spans four checkouts rather than two because two separate repos
				// have an Alembic tree; devkit is absent because it has no database.
				"label": "DB: New Migration (Autogenerate)",
				"detail": "Run `alembic revision --autogenerate` sequentially in each selected database checkout. ALWAYS READ EVERY GENERATED FILE before committing. It never runs `upgrade`, but each database must be up and current.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:dbCheckout}",
					"db-revision",
					"-m",
					"${input:migrationMessage}"
				],
				"icon": {
					"id": "database",
					"color": "terminal.ansiBrightRed"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			// --- workspace-scoped: act across every checkout ---------------------
			{
				"label": "Project: New from devkit",
				"detail": "Scaffold a whole new project — templates, Docker stack on registry-allocated ports, vendored devkit harness, parallel worktree, PR gate, and a PRIVATE GitHub repo. Registers it in this workspace's folder list and project picker. DRY RUN by default: pick 'Apply' to actually write.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Project: New from devkit",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Project: New from devkit",
					"--",
					"python",
					"scripts/new-project.py",
					"${input:newProjectName}",
					"--preset",
					"${input:newProjectPreset}",
					"--description",
					"${input:newProjectDescription}",
					"${input:newProjectRemote}",
					"${input:newProjectApply}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "new-folder",
					"color": "terminal.ansiCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"clear": true,
					"close": false
				},
				"problemMatcher": []
			},
			{
				// The step that used to be the human's, and the only one in the release
				// that needed judgement rather than typing: the prepare PR is red BY
				// CONSTRUCTION on one named test, because FALLBACK_DEVKIT_REF has to
				// point at a tag that does not exist yet. `release-pipeline.py` reads
				// the gate's own test artifact and refuses to merge on any other red,
				// which is what makes "merge a failing PR" safe to put behind a click.
				"label": "Devkit: Cut Release",
				"detail": "DRY RUN by default — prints the plan and stops. Applied, this bumps FALLBACK_DEVKIT_REF, opens the prepare PR, WAITS for the PR gate, merges it if the only failure is the expected one, dispatches the tag workflow, then opens an adoption PR in each consumer you tick. Minutes, mostly waiting on CI.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"release",
					"${input:releaseLevel}",
					// One token, not a flag and a value: `plan_command` drops empty
					// arguments, and a flag whose value went with them is left dangling.
					"--projects=${input:adoptProjects}",
					"${input:sweepApply}"
				],
				"icon": {
					"id": "tag",
					"color": "terminal.ansiBrightYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				// The consumers are ticked, not typed. `--all` is still what the 03:00
				// pass and the release pipeline pass, and it is what ticking every box
				// amounts to -- but a click that could only ever mean "all five" made the
				// one thing a human is at the dropdown for, adopting somewhere and not
				// everywhere, a terminal command instead.
				"label": "Devkit: Upgrade Projects",
				"detail": "DRY RUN by default. Adopt the current devkit release in each consumer you tick, one PR per repo — the catch-up click for a night the 03:00 pass did not run. A consumer already current costs a fetch; one whose adoption PR is already open is left alone.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Devkit: Upgrade Projects",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Devkit: Upgrade Projects",
					"--",
					"python",
					"scripts/upgrade-project.py",
					"${input:adoptProjects}",
					"${input:sweepApply}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "package",
					"color": "terminal.ansiBlue"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			// --- the ephemeral tier: a box per task, destroyed when the work leaves it ---
			//
			// Deliberately one task and not four. `New Box`, `Reap Finished Boxes` and
			// `Reconcile` were retired because none of them had a caller who was not an
			// agent, and an agent reaches every one of them through the CLI:
			//
			//   - New Box cut a box with no `--session`, and `worktree-guard.py` keys its
			//     lookup on the lease (one box per session+project). So a hand-cut box is
			//     adopted by nobody, costs a cold toolchain install and a port slot out of
			//     a fixed ceiling, and `reconcile_action` reaps it as "never used".
			//   - Reconcile is the `devkit-worktree-reconcile` scheduled task, which runs
			//     the same pass every fifteen minutes; `install-reconcile-task.py` owns its
			//     arguments. The one-click copy was also the more dangerous of the two: it
			//     passed no `--merge-label`, so "also merge every green PR" meant every
			//     green PR, where the schedule merges only what carries the label.
			//   - Reap Finished Boxes could never reap anything reconcile would not, and
			//     usually less: `reap_decision`'s `awaiting_pr` refuses a pushed box that
			//     has no PR in hand, which reconcile reaps under disk pressure or past
			//     `max_age_days`.
			//
			// What is left is the read-only view, because boxes are absent from `folders`
			// by design and nothing else reports them. Doing any of the three by name is
			// `worktree.py new|reap|reconcile`.
			{
				"label": "Worktree: List Boxes — read-only",
				"detail": "Every live box, its branch, its port slot, and whether its work has left it yet. Boxes are absent from this workspace's folder list by design, so nothing else reports them — a forgotten one holds a slot out of a fixed ceiling and, if its project has a stack, a container and volume set. Touches nothing.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Worktree: List Boxes",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Worktree: List Boxes",
					"--",
					"python",
					"scripts/worktree.py",
					"list",
					"${input:sweepFetch}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "list-tree",
					"color": "terminal.ansiCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				// This agent recovery task takes NO checkout, and deliberately so. Every
				// picker in this file lists the static checkouts; a session that ran in an
				// ephemeral box is unreachable from all of them, because boxes are absent
				// from `folders` by design. What you want back is the last few sessions
				// wherever they happened, so the script reads the transcript store — which
				// records each session's own directory — instead of asking.
				"label": "Agents: Resume Recent Sessions",
				"detail": "Check Claude, Codex, or both and choose how many sessions, then reopen the globally most recent matching sessions in a new Windows Terminal window, one tab each, OLDEST TAB FIRST. Scope-blind: no project picker, so it reaches sessions run in an ephemeral box too. Claude subagent transcripts and sessions whose directory has been reaped are skipped and named. Resuming a session that is still open elsewhere gives you a second window on it. The checked CLIs are updated first, which takes a few seconds and is the one moment they can be — an update cannot replace a binary a running agent is executing, so any agent already up is skipped.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/resume-sessions.py",
					"--agent",
					"${input:resumeAgents}",
					"--count",
					"${input:resumeSessionCount}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "history",
					"color": "terminal.ansiBrightMagenta"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				// MAINTAINED BY new-project.py. Command inputs must return one string, so
				// the extension joins checked names with commas. devkit_project.py splits
				// that value, validates every checkout up front, then runs sequentially.
				"id": "project",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which checkout(s) should run this task?",
					"key": "projects",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select one or more checkouts",
							"minCount": 1,
							"options": [
								"carameli",
								"ibkr_trader",
								"devkit",
								"data-lake",
								"sports_betting",
								"roguelike"
							]
						}
					]
				}
			},
			{
				// MAINTAINED BY new-project.py, like `project`: `insert_picker_option`
				// names both, so a registered project reaches this list without anyone
				// remembering, and a retired one leaves it.
				//
				// It lists the registry MINUS devkit, and that exclusion is a correctness
				// requirement rather than tidiness. devkit is the checkout a release is
				// pulled *from*, and `upgrade-project.py` treats a checkout that was named
				// and cannot be a target as an operator error -- so one stray tick would
				// exit 2 for the whole run, where `--all` skips devkit silently.
				//
				// Ticks are remembered rather than cleared: it is the same set of
				// consumers most nights, and both clicks that ask this share one key, so
				// the catch-up run offers whatever the release chose.
				"id": "adoptProjects",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which consumers should adopt this devkit release?",
					"key": "adoptProjects",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select one or more consumers",
							"minCount": 1,
							"options": [
								"carameli",
								"ibkr_trader",
								"data-lake",
								"sports_betting",
								"roguelike"
							]
						}
					]
				}
			},
			{
				// The daemon restart/fix actions are machine-scoped. Running either once
				// per checked project would restart the same Docker Desktop repeatedly.
				"id": "daemonProject",
				"type": "pickString",
				"description": "Which checkout should supply the Docker override?",
				"options": [
					"carameli",
					"ibkr_trader",
					"devkit",
					"data-lake",
					"sports_betting",
					"roguelike"
				],
				"default": "carameli"
			},
			{
				// The second question "Test: Run Suite" asks, and a checkbox list for the
				// same reason `project` above is one: more than one of these is routinely
				// wanted at once — a suite plus the vendored hook tests, or Vitest plus the
				// bundle budgets it can never reach on its own — and single-picks made that
				// two clicks through two prompts and two artifacts.
				//
				// It does NOT hide the rows a ticked checkout cannot run, and that is a
				// decision rather than a limitation. Sibling `${input:...}` resolve in no
				// defined order with no sight of one another, and this extension's own
				// `dependsOn` filters the RESULT rather than the list — a tick that
				// silently disappears, which is the one outcome worse than an irrelevant
				// row. So every row states its scope, and devkit_project.py prints the
				// pairs it skipped and why.
				//
				// The two PAID rows at the foot are the one place remembering costs money
				// rather than a keystroke. They are last, and their labels lead with the
				// word, because a checkbox list has nowhere else to put a warning: there is
				// no per-row confirmation, and `minCount` cannot express "not that one".
				//
				// `value` is what travels (the extension joins the checked VALUES with
				// `separator`); the remembered set is stored by LABEL, so editing a label
				// costs the next reader one re-tick and nothing else. `picked` seeds the
				// first run only — a remembered set replaces it. devkit_project.py's
				// TEST_KINDS is the same list from the other side, and
				// `test_the_menu_and_the_dispatcher_offer_the_same_kinds` pins the two
				// together in both directions.
				"id": "testKinds",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which kinds of test? (space ticks, enter runs)",
					"key": "testKinds",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select one or more kinds",
							"minCount": 1,
							"options": [
								{
									"label": "Suite — the checkout's own pytest run",
									"value": "suite",
									"description": "every checkout · scripts/run-tests.py",
									"picked": true
								},
								{
									// `--changed` is the canonical spelling everywhere: devkit,
									// the template, and the vendored Stop hook's remediation
									// line. carameli used to spell it `--fast`, which meant that
									// advice died on "Unknown argument"; it now accepts
									// `--changed` and keeps `--fast` as a deprecated alias.
									"label": "Suite — changed files only",
									"value": "suite-changed",
									"description": "every checkout · the working-tree diff, vs HEAD plus untracked"
								},
								{
									// Its own row rather than part of the suite because
									// pytest's testpaths deliberately excludes
									// scripts/hooks/tests/ in EVERY consumer. Includes
									// test_codex_translation.py, which judges every response
									// the project's hooks can emit against Codex's published
									// output schema — statically, with no CLI and no cost.
									"label": "Harness hook tests — the vendored tier",
									"value": "hooks",
									"description": "every checkout · fails loudly where the harness is not vendored"
								},
								{
									"label": "Carameli free targets — all of them, one artifact",
									"value": "all-targets",
									"description": "carameli only · pytest + hooks + frontend + bundle budgets merged; paid tiers stay CLI-only"
								},
								{
									"label": "Carameli frontend (Vitest)",
									"value": "frontend",
									"description": "carameli only · unit tests, no build"
								},
								{
									// Separate from the Vitest row above because `test:run`
									// never builds, and so can never reach these budgets.
									"label": "Carameli frontend bundle budgets",
									"value": "bundle-budgets",
									"description": "carameli only · production build, measured against frontend/bundlePolicy.ts"
								},
								{
									"label": "Carameli public webhook reachability",
									"value": "webhook",
									"description": "carameli only · needs the public URL to be live"
								},
								{
									"label": "Browser E2E — headless",
									"value": "e2e",
									"description": "carameli only · NEEDS the stack and the Vite server up first"
								},
								{
									"label": "Browser E2E — headed, watch the browser",
									"value": "e2e-headed",
									"description": "carameli only · NEEDS the stack and the Vite server up first"
								},
								{
									"label": "Browser E2E — cross-browser",
									"value": "e2e-cross",
									"description": "carameli only · Chromium, Firefox, WebKit; NEEDS the stack and Vite up"
								},
								{
									// The two paid rows, last in the list so that the distance
									// from `suite` is as large as the menu can make it. They
									// were one task with a single-pick of claude/codex/both;
									// ticking both of these IS `both`, which is why there is no
									// third row. Untick them: the set is remembered.
									"label": "PAID — live Claude CLI hook smoke",
									"value": "hooks-live-claude",
									"description": "devkit only · SPENDS MONEY · one real authenticated Claude session"
								},
								{
									"label": "PAID — live Codex CLI hook smoke",
									"value": "hooks-live-codex",
									"description": "devkit only · SPENDS MONEY · two real authenticated Codex sessions"
								}
							]
						}
					]
				}
			},
			{
				// `testScope`'s counterpart, and the same two branches for the same
				// reason: every project's lint-all.py accepts `--changed`, and the
				// empty value is dropped by devkit_project.py before exec rather than
				// reaching argparse as a stray positional.
				//
				// The default is the WIDE scope, unlike a "changed only" default would
				// be, because lint rewrites what it reads: a run scoped to the diff
				// leaves the rest of the tree unformatted, and the click that most
				// often precedes a commit should be the one that cannot miss a file.
				"id": "lintScope",
				"type": "pickString",
				"description": "How much of the checkout to lint",
				"options": [
					{
						"label": "Everything (default)",
						"value": ""
					},
					{
						"label": "Changed only — the working-tree diff",
						"value": "--changed"
					}
				],
				"default": ""
			},
			{
				// The checkout picker for the project-SCOPED tasks. Deliberately not the
				// `project` picker above: three of the five checkouts it lists have no
				// comic-book art and no ngrok tunnel, and offering them would make the
				// wrong answer available at exactly the moment you are least likely to
				// notice. The dispatcher validates the same restriction from its side
				// (`Action.projects`), so this list is UX, never the guarantee.
				//
				// It used to front for the three carameli TEST tasks as well. Those are
				// rows on `testKinds` now, where the scope is stated per row rather than
				// per picker — a menu shared by every checkout cannot narrow its list to
				// the ticked ones, and saying so beats dropping the tick silently.
				//
				// The extension remembers checked items per workspace. The dispatcher
				// still validates the action's scope before starting either checkout.
				"id": "carameliCheckout",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which Carameli checkout(s) should run this task?",
					"key": "carameliCheckouts",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select the checkout",
							"minCount": 1,
							"options": ["carameli"]
						}
					]
				}
			},
			{
				"id": "ibkrCheckout",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which IBKR Trader checkout(s) should run this task?",
					"key": "ibkrCheckouts",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select the checkout",
							"minCount": 1,
							"options": ["ibkr_trader"]
						}
					]
				}
			},
			{
				// Four options, not two: `db-revision` is the one scoped action that
				// spans two repos, because both have an Alembic tree. devkit is absent
				// because it has no database (`[db] enabled = false`), and it is absent
				// from `DB_PROJECTS` for the same reason — the two lists have to agree,
				// and a test asserts they do.
				"id": "dbCheckout",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which checkout(s) should generate this migration?",
					"key": "dbCheckouts",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select one or more database checkouts",
							"minCount": 1,
							"options": [
								"carameli",
								"ibkr_trader"
							]
						}
					]
				}
			},
			{
				// Free text, and it reaches a shell inside carameli's app container (the
				// PgBouncer bypass needs `sh -c` to expand $DIRECT_DATABASE_URL), so that
				// script quotes it. ibkr_trader's passes it as its own argv element and
				// never involves a shell at all.
				"id": "migrationMessage",
				"type": "promptString",
				"description": "Short description of the schema change (becomes part of the migration filename)",
				"default": ""
			},
			{
				"id": "ingestSource",
				"type": "pickString",
				"description": "Which data source to pull",
				"options": [
					{ "label": "FMP prices — batch", "value": "fmp-prices-batch" },
					{ "label": "FMP prices — one symbol", "value": "fmp-price-one" },
					{ "label": "Yahoo prices — batch", "value": "yahoo-prices-batch" },
					{ "label": "Yahoo fundamentals — batch", "value": "yahoo-fundamentals-batch" },
					{ "label": "Alpha Vantage prices — batch", "value": "alpha-vantage-batch" },
					{ "label": "Finnhub news — batch", "value": "finnhub-news-batch" },
					{ "label": "Finnhub news — one symbol", "value": "finnhub-news-one" },
					{ "label": "NewsAPI headlines — batch", "value": "newsapi-batch" },
					{ "label": "Google Trends — batch", "value": "trends-batch" },
					{ "label": "Google Trends — one keyword", "value": "trends-one" },
					{ "label": "Reddit", "value": "reddit" },
					{ "label": "FMP FX — one pair", "value": "fmp-fx" },
					{ "label": "Yahoo FX — deep-history backfill", "value": "yahoo-fx-backfill" }
				],
				"default": "fmp-prices-batch"
			},
			{
				// Consumed as `--arg=${input:ingestArg}`, one token, NOT as a separate
				// `--arg` flag followed by this value. An empty answer is the common case
				// (ten of the thirteen sources ignore it), and as two tokens the empty one
				// is dropped in transit, leaving a dangling `--arg` for argparse to
				// misread. `--arg=` with nothing after it is unambiguous.
				"id": "ingestArg",
				"type": "promptString",
				"description": "Optional symbol, keyword, or FX pair for single-item modes",
				"default": ""
			},
			{
				// Every branch supplies one real token — `--full` is redundant against
				// the script's own default and exists for exactly that reason.
				"id": "snapshotScope",
				"type": "pickString",
				"description": "Full ritual, or re-run just the snapshot over data already ingested?",
				"options": [
					{
						"label": "Full ritual — migrations, prices, aggregation, snapshot",
						"value": "--full"
					},
					{
						"label": "Snapshot only — skip the price ingests",
						"value": "--skip-ingest"
					},
					{
						"label": "Dry run — print the plan, run nothing",
						"value": "--dry-run"
					}
				],
				"default": "--full"
			},
			{
				"id": "btStrategy",
				"type": "pickString",
				"description": "Allocator to simulate",
				"options": [
					"ml_lt_ridge",
					"ml_lt",
					"momentum_lt",
					"equal_weight",
					"buy_and_hold"
				],
				"default": "ml_lt_ridge"
			},
			{
				// Shared by both Backtest tasks — the account is the one input the OOS
				// run still takes, since which account you evaluate does not affect
				// whether two OOS runs are comparable.
				"id": "btAccount",
				"type": "pickString",
				"description": "Registered account to simulate",
				"options": [
					"tfsa",
					"rrsp",
					"fhsa",
					"lira",
					"nonreg"
				],
				"default": "tfsa"
			},
			{
				"id": "btUniverseFile",
				"type": "pickString",
				"description": "Universe file",
				"options": [
					{ "label": "tickers-etfs.txt — ETF floor", "value": "tickers-etfs.txt" },
					{ "label": "tickers.txt — stocks + ETFs", "value": "tickers.txt" }
				],
				"default": "tickers-etfs.txt"
			},
			{
				"id": "btStart",
				"type": "promptString",
				"description": "Bar-load start",
				"default": "2008-06-02"
			},
			{
				"id": "btEvalStart",
				"type": "promptString",
				"description": "First decision date",
				"default": "2010-01-04"
			},
			{
				"id": "btEnd",
				"type": "promptString",
				"description": "Window end",
				"default": "2030-01-01"
			},
			{
				"id": "oosEnd",
				"type": "promptString",
				"description": "OOS dataset window end",
				"default": "2026-07-01"
			},
			{
				"id": "newProjectName",
				"type": "promptString",
				"description": "New project name — becomes the directory, the Python package, and COMPOSE_PROJECT_NAME",
				"default": ""
			},
			{
				"id": "newProjectPreset",
				"type": "pickString",
				"description": "Project shape. Individual features can be added later with --with-* flags.",
				"options": [
					{
						"label": "service — Docker + app + Postgres + Alembic",
						"value": "service"
					},
					{
						"label": "service-redis — the above plus Redis",
						"value": "service-redis"
					},
					{
						"label": "data — Postgres + the data-lake archive seam (ibkr_trader's shape)",
						"value": "data"
					},
					{
						"label": "fullstack — service-redis plus a Vite frontend (carameli's shape)",
						"value": "fullstack"
					},
					{
						"label": "bare — no Docker, no database; just the harness and CI",
						"value": "bare"
					}
				],
				"default": "service"
			},
			{
				"id": "newProjectDescription",
				"type": "promptString",
				"description": "One-line description (goes into README.md, CLAUDE.md, and pyproject.toml)",
				"default": ""
			},
			{
				// Both pickers supply one real token in every branch, never "". An empty
				// string in an args array reaches argparse as a stray positional and is
				// rejected — which is why new-project.py carries the redundant-looking
				// `--dry-run` and `--remote` flags alongside their negations.
				"id": "newProjectRemote",
				"type": "pickString",
				"description": "Create a PRIVATE GitHub repo and push? (ignored on a dry run)",
				"options": [
					{
						"label": "Yes — create alexandrec90/<name> as private, and push",
						"value": "--remote"
					},
					{
						"label": "No — local only, wire up the remote later",
						"value": "--no-remote"
					}
				],
				"default": "--remote"
			},
			{
				"id": "newProjectApply",
				"type": "pickString",
				"description": "Dry run prints the full plan and writes nothing. Run it once before applying.",
				"options": [
					{
						"label": "Dry run — print the plan, write nothing",
						"value": "--dry-run"
					},
					{
						"label": "Apply — write files, init git, add the worktree",
						"value": "--yes"
					}
				],
				"default": "--dry-run"
			},
			{
				"id": "sweepFetch",
				"type": "pickString",
				"description": "Fetch every remote first?",
				"options": [
					{
						"label": "Fetch — accurate ahead/behind counts (slower)",
						"value": "--fetch"
					},
					{
						"label": "Skip fetch — instant, counts may be stale",
						"value": "--no-fetch"
					}
				],
				"default": "--fetch"
			},
			{
				"id": "sweepApply",
				"type": "pickString",
				"description": "Dry run, or actually change the checkouts?",
				"options": [
					{
						"label": "Dry run — print the plan, change nothing",
						"value": "--dry-run"
					},
					{
						"label": "Apply — run the git commands shown",
						"value": "--yes"
					}
				],
				"default": "--dry-run"
			},
			{
				// Patch is first AND the default because it is the answer almost every
				// time: a devkit release delivers whatever has merged since the last
				// one, and "what merged" is a set of fixes, not a decision about
				// compatibility. The script also accepts an explicit vX.Y.Z, which the
				// one case the bumps cannot express needs — re-cutting after a tag was
				// deleted — but that stays on the CLI: a pickString cannot take free
				// text, and a promptString here would let a typo name the release.
				//
				// The labels name no versions, and that is a correction rather than an
				// omission. They spelled out a worked example — the newest tag on the
				// day they were written, and each bump's result from it — which is the
				// most useful thing this list could say and a claim nothing owns:
				// nothing renders this file from the tag list, so the first release cut
				// afterwards left every option describing a version that already
				// existed, offering "the usual" patch as the tag it had just
				// superseded. What a click gets is a DRY RUN, and `release-pipeline.py`
				// prints the resolved version as its first line — so the concrete
				// number is one click away and read from `git tag` rather than from a
				// dropdown someone last edited.
				"id": "releaseLevel",
				"type": "pickString",
				"description": "How far should the version move?",
				"options": [
					{
						"label": "Patch — the usual",
						"value": "patch",
						"description": "last digit; delivers whatever has merged since the newest tag"
					},
					{
						"label": "Minor — new capability",
						"value": "minor",
						"description": "middle digit, and the patch resets to 0"
					},
					{
						"label": "Major — consumers must change",
						"value": "major",
						"description": "first digit, and the rest resets to 0"
					}
				],
				"default": "patch"
			},
			{
				// Selecting both agents means one global recency slice, not `count` from
				// each store. The extension joins the checked values into the one token
				// accepted by resume-sessions.py's `--agent` option.
				"id": "resumeAgents",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which agents' sessions should be considered? Check both for last X across either agent.",
					"key": "resumeAgents",
					"multiPick": true,
					"multiPickStorage": "workspace",
					"separator": ",",
					"optionGroups": [
						{
							"label": "Select one or both agents",
							"minCount": 1,
							"options": ["claude", "codex"]
						}
					]
				}
			},
			{
				"id": "resumeSessionCount",
				"type": "promptString",
				"description": "How many of the most recently active sessions to reopen",
				"default": "4"
			},
			{
				// MAINTAINED BY new-project.py, like `project` — but from the RAW
				// registry rather than `known_projects`, because a reference checkout
				// can take this action and no other. The two lists coincide only while
				// `NOT_PROJECTS` is empty, which is the case today. Single-pick: a merge
				// conflict is resolved per repo, so batching them would just queue up
				// two half-finished merges.
				"id": "mergeCheckout",
				"type": "pickString",
				"description": "Which checkout should take origin's default branch?",
				"options": [
					"carameli",
					"ibkr_trader",
					"devkit",
					"data-lake",
					"sports_betting",
					"roguelike"
				],
				"default": "carameli"
			},
			{
				// Every branch supplies one real token — `auto` rather than "" — for the
				// reason spelled out on `newProjectRemote`. `auto` reads the branch off
				// refs/remotes/origin/HEAD, so a repo whose trunk is `develop` needs no
				// entry here; the named ones are for merging from somewhere other than
				// the trunk.
				"id": "mergeBase",
				"type": "pickString",
				"description": "Which branch to merge FROM",
				"options": [
					{
						"label": "Auto — origin's own default branch",
						"value": "auto"
					},
					{
						"label": "develop",
						"value": "develop"
					},
					{
						"label": "main",
						"value": "main"
					},
					{
						"label": "master",
						"value": "master"
					}
				],
				"default": "auto"
			},
			{
				// The dropdown pair this task asks with. The extension cannot RUN anything to
				// build a list, so both read the option file `preview-task.py` writes under
				// devkit's `logs/` — which makes the list a SCAN, not live state. What keeps it
				// current is not a task run: `worktree.py reconcile` rewrites the file on every
				// pass, and the scheduled pass runs every fifteen minutes, so open PRs appear
				// and merged ones leave without anyone asking. Each project's first row is its
				// default branch, and the header row carries the scan's timestamp. On a machine
				// where that pass has never run, `python devkit/scripts/preview-ui-host.py
				// --refresh` writes the file and picks nothing.
				//
				// There is no `Rescan` row and there must not be one again: a self-service row
				// makes staleness the reader's problem on every single open, and the thing it
				// asked them to notice — an open PR missing from the list — is the file's
				// writer's job. `.claude/rules/vscode-tasks.md` carries the general form.
				//
				// `previewProject` is NESTED inside this input rather than declared beside it,
				// because the second list depends on the first: the extension resolves a nested
				// `pickStringRemember` first and substitutes the answer into the expressions
				// below. Two sibling inputs would resolve in whatever order VS Code chose, and
				// neither could read the other.
				//
				// The pick fires ONCE, in `value`: the extension substitutes each template
				// string in turn, and EVERY `${pickStringRemember:...}` occurrence opens its
				// own quick-pick — spelled in all four fields, the project dropdown appeared
				// four times per run. `value` resolves first, the pick stores its answer under
				// its `key`, and the other three fields read it back with
				// `${remember:previewProject}`, which never prompts.
				//
				// The value is one token, `<project>:<ref>`, because a VS Code input resolves to
				// one string. `git check-ref-format` refuses a ref containing a colon, so the
				// first one always separates the two halves.
				//
				// Several rows at a time: `multiPick` draws the list with checkboxes and joins
				// the ticked values with `separator`. A SPACE, rather than the comma the
				// `project` picker uses, for the same reason the colon above was chosen over
				// something merely conventional — a comma is legal in a git ref name and a
				// space is not, so the separator cannot fall inside the half that varies.
				// `preview-task.py` splits on it, drops any pick that would land in a box
				// another pick has already claimed, then starts the boxes in turn and waits on
				// all of them at once.
				//
				// `clearStorage`, which is the one place this deliberately differs from the
				// `project` picker: that picker's options are the checkout registry, which does
				// not move, so pre-ticking last time's answer is a convenience. These options
				// are refs the previous scan happened to find, so remembering the ticked set
				// turns "also show me this one" into "re-serve everything I have looked at
				// since Tuesday".
				//
				// Omitting `multiPickStorage` does NOT buy that, which is what this comment
				// claimed until the extension's source was read: a `multiPick` stores its
				// ticked labels either way, and the argument only chooses global over
				// workspace storage. The remembered set then overwrites each option's own
				// `picked`, so the second click reopened on the previous answer with nothing
				// in this file asking for it. `clearStorage` drops the set before the list is
				// built, which is the behaviour the paragraph above always described.
				"id": "previewRow",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which branch, PR or box should be brought up? Tick as many as you want.",
					"key": "previewRow",
					// NO `checkEscapedUI`, and its absence is the fix for a task that could be
					// used exactly once per window. The flag is a STICKY bit: escaping stores
					// `__escapedUI: true` in the extension's `rememberStore` (`storeEscapedUI`
					// in extension-common.js), every later command that opts in returns
					// `undefined` BEFORE its quick-pick opens, and that early return is the one
					// path that never clears the bit it just read. Nothing else clears it, so one
					// Escape retired both dropdowns for the life of the window, with no list ever
					// appearing again.
					//
					// What that leaves behind is the half the extension's README denies. It says
					// an escaped UI "will not start the task/launch" — and on this VS Code the
					// task starts: a dismissed `project` picker on 2026-08-26 left
					// `devkit-ports: no slot registered for '${input:project}'`, exit 1, in
					// `logs/ports-show-checkout-allocations.log` (overwritten per run, hence the
					// quote). That is a task running on the same `undefined` this flag returns,
					// so opting in would buy a dropdown that stops opening and no cancel at all.
					// The cancel is `scripts/task_input.py`, in the script that receives the
					// literal — which is the only tier that observably gets a say.
					"multiPick": true,
					"clearStorage": true,
					"separator": " ",
					"fileName": "${workspaceFolder:devkit}/logs/preview-menu.json",
					"fileFormat": "json",
					"jsonOption": {
						"value": "content.rows['${pickStringRemember:previewProject}'][__itemIdx__].value",
						"label": "content.rows['${remember:previewProject}'][__itemIdx__].label",
						"description": "content.rows['${remember:previewProject}'][__itemIdx__].description",
						"detail": "content.rows['${remember:previewProject}'][__itemIdx__].detail"
					},
					"pickStringRemember": {
						"previewProject": {
							"description": "Which checkout has the branch you want to look at?",
							"key": "previewProject",
							// No `checkEscapedUI` here either, and for the sharper half of the
							// reason above: this is the FIRST pick of the pair, so it is the
							// one an Escape usually lands on, and the bit it would set is read
							// by the outer command on the next run.
							"fileName": "${workspaceFolder:devkit}/logs/preview-menu.json",
							"fileFormat": "json",
							"jsonOption": {
								"value": "content.projects[__itemIdx__].name",
								"label": "content.projects[__itemIdx__].label",
								"description": "content.projects[__itemIdx__].description"
							}
						}
					}
				}
			},
			{
				// Both branches carry a real flag rather than one being an empty default:
				// this picker feeds the script directly, not devkit_project.py, so an
				// empty branch would reach argparse as a stray positional. `--live` is
				// what the script already does with no argument at all, and exists for
				// that rule.
				"id": "taskIndexSource",
				"type": "pickString",
				"description": "Which copy of the workspace file should be listed?",
				"options": [
					{
						"label": "The live workspace — what VS Code is running now",
						"value": "--live"
					},
					{
						"label": "devkit's workspace.jsonc — the reviewable copy on this branch",
						"value": "--canonical"
					}
				],
				"default": "--live"
			},
			{
				// The checkbox list that used to be drawn in a terminal by the script it
				// feeds. `scripts/plug-projects.py --refresh-menu` writes the options file;
				// `worktree.py reconcile` rewrites it every fifteen minutes, and so does a
				// run that changes the registry, because the rows' TICKS are the registry
				// and a menu whose ticks predate the last edit is wrong in the one way that
				// matters. `.claude/rules/vscode-tasks.md` carries the general form.
				//
				// `fileFormat: "load"` takes the file as the option groups verbatim, which
				// is the difference from `previewRow` above: no `__itemIdx__` expression is
				// evaluated per field, so a row missing one cannot draw ten thousand blank
				// entries. Python writes the whole structure, each row's `picked` included.
				//
				// `clearStorage` is what makes `picked` mean anything. Every `multiPick`
				// remembers its ticked LABELS in workspace state whether or not
				// `multiPickStorage` was asked for — that argument only chooses global over
				// workspace storage — and `pickStringRemember` overwrites each option's own
				// `picked` with the remembered set whenever it finds one. So without this
				// flag the second click would open on what was ticked last time rather than
				// on what is registered now, which for this list is not a stale convenience
				// but a wrong answer: the ticks ARE the state being edited.
				//
				// No `checkEscapedUI`, for the reason spelled out on `previewRow`: it is a
				// sticky bit nothing clears, so one Escape would retire this dropdown for the
				// life of the window without buying the cancel its README promises. Escape
				// here leaves the literal `${input:plugSelection}` in the argument, which
				// `notify-wrap.py` recognises as a cancel and refuses to run — and which the
				// script reads as "nothing was picked" if it is reached any other way.
				"id": "plugSelection",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Which projects belong in the workspace registry? Ticked = plugged in. OK applies, Esc cancels.",
					"key": "plugSelection",
					"multiPick": true,
					"clearStorage": true,
					"separator": ",",
					"optionGroups": {
						"fileName": "${workspaceFolder:devkit}/logs/plug-menu.json",
						"fileFormat": "load"
					}
				}
			}
		]
	}
	,
	"settings": {
		"powershell.cwd": "carameli",
		// Projects nothing should be in flight for. `upgrade-project.py --all` passes over
		// them and `worktree.py` reports any box cut for one as stranded at any age
		// (`sweep.on_hold`). Naming a project explicitly on the command line still works.
		"devkit.onHold": ["ibkr_trader", "data-lake", "sports_betting"]
	}
}
