				},
				"problemMatcher": []
			},
			{
				"label": "Backtest: Run",
				"detail": "Simulate the chosen allocator and universe sequentially in each selected IBKR Trader checkout. Each `db` container must be up; writes to artifacts/tasks/backtest-run.log.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:ibkrCheckout}",
					"backtest",
					"--strategy",
					"${input:btStrategy}",
					"--account",
					"${input:btAccount}",
					"--universe-file",
					"${input:btUniverseFile}",
