				"problemMatcher": []
			},
			{
				"label": "Devkit: Upgrade Projects",
				"detail": "DRY RUN by default. Adopt the current devkit release in every consumer that is behind, one PR per repo — the catch-up click for a night the 03:00 pass did not run. A consumer already current costs a fetch; one whose adoption PR is already open is left alone.",
				"type": "process",
