				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			// --- the ephemeral tier: a box per task, destroyed when the work leaves it ---
			//
			// Deliberately three tasks and not four: there is no "reap one box" entry,
			// because a picker cannot enumerate boxes that are created between clicks.
			// Reaping by name is the CLI (`worktree.py reap <box> --yes`), and the one-click
			// shape is the sweep, which steps over every box still holding work.
			{
				"label": "Worktree: New Box",
				"detail": "Cut a disposable worktree for one task: a fresh claude/… branch off origin/<default>, its own port-slot lease and COMPOSE_PROJECT_NAME, and its toolchain installed (uv sync / pip locks / npm, whichever the project uses — a cold install can take minutes). Leave the topic blank to name it after the project. DRY RUN by default.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Worktree: New Box",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Worktree: New Box",
					"--",
					"python",
					"scripts/worktree.py",
					"new",
					"${input:worktreeProject}",
					"--slug",
					"${input:worktreeSlug}",
					"${input:sweepApply}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "repo-forked",
					"color": "terminal.ansiCyan"
