// devkit owns this file. It is the CANONICAL alex-projects.code-workspace.
//
// The live workspace file sits outside every repo, so for years it was the source of
// truth and this copy was a mirror taken from it. That inverted the only property
// worth having: the file every agent writes to had no branch, no history and no
// review, so two sessions editing it raced with last-writer-wins, and a single
// session's in-flight edit was globally live before its PR was even opened. It is
// how alex-projects.code-workspace came to be running an UNMERGED branch's task
// block (PR #177, 2026-08-21) for every window on the machine.
//
// So the direction is now canonical -> live:
//
//     python scripts/devkit_project.py --check-workspace    // do they agree?
//     python scripts/devkit_project.py --render-workspace   // this file -> the live one
//     python scripts/devkit_project.py --adopt-workspace    // the live one -> this file
//
// Edit THIS file, on a task branch, and let `--render-workspace` publish it once the
// PR merges. Two agents then conflict in git, where a conflict is visible and
// resolvable, instead of in a file with no history. `--adopt-workspace` remains for
// the other direction — a hand edit in VS Code, or a workspace setting the editor
// wrote itself — and rendering refuses rather than overwriting one.
//
// Comparison is SEMANTIC (parsed), not byte-for-byte: VS Code reformats this file
// when it writes a setting through its own UI, and flagging that would train
// everyone to ignore the check.
{
	// The one workspace. Every checkout lives here, and `sweep.py` reads this
	// `folders` list as the project registry — a project missing from it is invisible
	// to every sweep, so nothing reports its stranded work: the session-start line
	// (`workspace-status.py`) and reconcile's checkout pass both read this list, and
	// there is no longer a task to run by hand instead. `new-project.py`
	// registers new projects here rather than writing a workspace file of its own.
	//
	// VanillaLand is the legacy Azure DevOps monolith Carameli replaces: a reference
	// checkout, not something we ship from. It is excluded by `sweep.DEFAULT_EXCLUDE`
	// and `devkit_project.NOT_PROJECTS`, and it is a SINGLE SHARED CHECKOUT — both the
	// primary and -b agents edit the same files, so hand ownership over explicitly
	// (launch-agent-tabs.ps1 -VanillaLandOwners) rather than assuming it.
	"folders": [
		{
			"path": "carameli"
		},
		{
			"path": "ibkr_trader"
		},
		{
			"path": "devkit"
		},
		{
			"path": "data-lake"
		},
		{
			"path": "sports_betting"
		},
		{
			"name": "VanillaLand (reference)",
			"path": "VanillaLand"
		}
	],
	"extensions": {
		"recommendations": [
			"rioj7.command-variable"
		]
	},
	// ---------------------------------------------------------------------------
	// EVERY task lives here. There are no project-level `.vscode/tasks.json` files left
	// in this workspace, and re-growing one is now a test failure in the repo that does
	// it rather than a matter of taste.
	//
	// The reason is arithmetic, not purity. This is a MULTI-ROOT workspace and every
	// repo is checked out twice — carameli/carameli-b, ibkr_trader/ibkr_trader-b. A task
	// defined inside a repo is therefore rendered once per FOLDER: two quick-pick entries
	// carrying the same label, nothing to say which checkout each one would run in, and
	// two copies that disagree the moment the worktrees sit on different branches. That
	// last part was not hypothetical — when these were deleted, carameli's two copies
	// had drifted to eight tasks versus two, and ibkr_trader's to five versus eleven,
	// with the SAME label ("Stop: Docker Stack") running different commands.
	//
	// So a project-specific task is not laundered into a generic one on the way up. It
	// keeps its project-specific script and gains a picker over the two checkouts that
	// can actually run it — which is all the `--project` argument ever was.
	// `devkit_project.py`'s `Action.projects` is the enforcement: `test-target`, `e2e`
	// and `ngrok` are defined for the carameli pair only, the five IBKR actions for the
	// ibkr_trader pair only, and the dispatcher refuses any other checkout BY NAME
	// instead of falling through to "does not implement this action", which reads like
	// an invitation to go implement it.
	//
	// Not everything that was in those files came up. The three-task frontend-preview
	// composite stayed deleted because it was broken, not merely duplicated: its Simple
	// Browser opened localhost:5174, while ports.toml allocates 5173 to carameli and
	// 5175 to carameli-b, so it had never once pointed at a running server in either
	// checkout. ibkr_trader's five hidden snapshot steps and carameli's stack start/stop
	// are here as one task each ("Snapshot: Run Monthly", "Docker: Start/Stop Stack").
	//
	// Every task routes through `devkit_project.py`, which resolves the picked name
	// against the `folders` list above and runs the action with cwd set to that
	// checkout. That replaced `${fileWorkspaceFolder}`, which needed an editor tab
	// open to anchor on and resolved to nothing when the picker was the only input.
	//
	// `${workspaceFolder:devkit}` (not `${workspaceFolder}`) is required: this is a
	// multi-root workspace, so the bare form is ambiguous and VS Code will not resolve
	// it. The named form is also why this file needs no absolute path.
	//
	// devkit owns and tests every script called here. If you are reading this in the
	// live `.code-workspace`, you are reading a RENDER: the copy with a branch and a
	// reviewer is `devkit/workspace.jsonc`, and `devkit_project.py --check-workspace`
	// is the gate between them. Edit the canonical one and
	// `--render-workspace`; `--adopt-workspace` goes the other way, for an edit VS
	// Code itself made. `.claude/rules/vscode-tasks.md` carries the why.
	//
	// Conventions. Label "Domain: Title Case Action". Every task carries a `detail` —
	// the second line of the quick-pick, and the only place a one-click action can state
	// its cost or blast radius. Every task carries an `icon`, and no two share the same
	// id+colour pair: with everything in one list, colour is what makes it scannable —
	// green quality, yellow lint/teardown, cyan sync, blue inspection, red destructive,
	// magenta ship/launch, and the BRIGHT variants for the project-scoped tasks, which
	// is how you can see at a glance that a task will ask you which checkout to use.
	"tasks":
	{
		"version": "2.0.0",
		"tasks": [
			// --- generic: pick a project ---------------------------------------
			{
				"label": "Test: Run Suite",
				"detail": "Each selected checkout's own test suite, run sequentially via its scripts/run-tests.py. Failures go to that checkout's logs/test-failures.log — read the artifact, not the terminal.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"test",
					"${input:testScope}"
				],
				"group": {
					"kind": "test",
					"isDefault": true
				},
				"icon": {
					"id": "beaker",
					"color": "terminal.ansiGreen"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Test: Harness Hook Tests — free",
				"detail": "The vendored tier's own stdlib-only tests in each selected checkout, run sequentially. Separate from 'Test: Run Suite' because pytest's testpaths deliberately excludes scripts/hooks/tests/ in EVERY consumer. Fails loudly on a checkout that does not vendor the harness.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"test-hooks"
				],
				"group": "test",
				// Not `beaker`/green: that is "Test: Run Suite", and the two sat
				// side by side in the picker as an identical icon under two labels.
				"icon": {
					"id": "zap",
					"color": "terminal.ansiGreen"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Test: Harness Hook Tests — paid, live CLI",
				"detail": "PAID — launches a real authenticated agent CLI against a throwaway project and proves the hooks change what it actually does. devkit only: these smokes live in tests/, which is never vendored. 'Claude only' is the cheapest run; each suite's model and budget are set in its own test file. Failures go to devkit/logs/hook-test-live-failures.log.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					// Written out rather than a picker: the action's scope is one checkout, so a
					// picker here would be a list of length one asking a question with no second
					// answer. `test_the_live_smoke_task_names_the_only_checkout_that_can_run_it`
					// pins this literal against `Action.projects` so the two cannot drift.
					"devkit",
					"test-hooks-live",
					"${input:liveHookSuite}"
				],
				"group": "test",
				// Same `zap` family as the free hook tests, in red: the colour is the only
				// warning a one-click paid task gets before it is clicked.
				"icon": {
					"id": "zap",
					"color": "terminal.ansiRed"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Lint: Everything",
				"detail": "Full-repo lint for each selected checkout, run sequentially via scripts/lint-all.py. Findings go to that checkout's logs/lint-errors.log.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"lint"
				],
				"group": "build",
				"icon": {
					"id": "checklist",
					"color": "terminal.ansiYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Lint: Changed Files",
				"detail": "Lint only the working-tree diff (vs HEAD, plus untracked) in each selected checkout. Runs sequentially; same artifact as 'Lint: Everything'.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"lint-changed"
				],
				"group": "build",
				// Same reason as the hook tests above — `checklist`/yellow is
				// "Lint: Everything"; the narrower scope gets the narrower icon.
				"icon": {
					"id": "list-selection",
					"color": "terminal.ansiYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Agent: Sync Codex Context",
				"detail": "Regenerate Codex repository skills and hook configuration in each selected checkout, sequentially. Changes from a clean home branch are packaged as autofix-labelled PRs and auto-merged after the gate passes.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"sync-codex"
				],
				"icon": {
					"id": "sync",
					"color": "terminal.ansiCyan"
				},
				"presentation": {
					"reveal": "silent",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Harness: Check Drift vs devkit",
				"detail": "Byte-compares each selected checkout's vendored scripts/hooks/ against devkit, sequentially. Needs DEVKIT_DIR set. Defaults to the read-only check; --pull and --push both rewrite files.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"sync-devkit",
					"${input:harnessMode}"
				],
				"icon": {
					"id": "diff",
					"color": "terminal.ansiCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			// --- the workspace file itself ------------------------------------
			// This file has no branch: one copy serves every VS Code window on the
			// machine, so an edit is globally live before anyone reviews it. devkit's
			// `workspace.jsonc` is the copy with a branch and a reviewer, and these
			// three are the only sanctioned way to move content between them. They are
			// NOT dispatches -- there is one workspace file, so there is nothing to
			// pick a checkout for, and the wrapping is written out here.
			{
				"label": "Workspace: Check Drift vs devkit's Copy",
				"detail": "Read-only. Compares the live .code-workspace against devkit's canonical workspace.jsonc — folders, extensions, tasks, inputs, settings — and names every difference. The full list the session-start line only counts.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Workspace: Check Drift vs devkit's Copy",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Workspace: Check Drift vs devkit's Copy",
					"--",
					"python",
					"scripts/devkit_project.py",
					"--check-workspace"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "multiple-windows",
					"color": "terminal.ansiBlue"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Workspace: Publish devkit's Copy",
				"detail": "Renders devkit's workspace.jsonc over the live .code-workspace — the file every VS Code window on this machine reads. REFUSES rather than clobbering a live edit devkit never wrote; adopt that first. Publishes whatever branch the devkit checkout is on, so check it out before clicking.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Workspace: Publish devkit's Copy",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Workspace: Publish devkit's Copy",
					"--",
					"python",
					"scripts/devkit_project.py",
					"--render-workspace"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "cloud-upload",
					"color": "terminal.ansiRed"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Workspace: Adopt Live Edits into devkit",
				"detail": "The other direction, for edits VS Code made itself — a workspace setting changed through its UI. Records the live file back into devkit's workspace.jsonc and leaves it UNCOMMITTED, so it reads as stranded work until you ship it on a task branch.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Workspace: Adopt Live Edits into devkit",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Workspace: Adopt Live Edits into devkit",
					"--",
					"python",
					"scripts/devkit_project.py",
					"--adopt-workspace"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "save",
					"color": "terminal.ansiCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Git: Sync Branch onto Origin Default (Keep Changes)",
				"detail": "For each selected checkout, sequentially: detect origin's default branch, then fetch → stash if dirty → rebase → pop. Keeps unstaged/untracked changes.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"sync-branch"
				],
				"icon": {
					"id": "git-merge",
					"color": "terminal.ansiGreen"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			{
				// The one task that reaches a REFERENCE checkout, and the reason it is
				// not a devkit_project.py dispatch: that dispatcher resolves through
				// `known_projects`, which drops NOT_PROJECTS because every action it
				// runs needs a harness. Merging a trunk in needs git and nothing else,
				// so this script resolves against the raw registry and its picker lists
				// VanillaLand alongside the projects.
				//
				// The sibling above REBASES, which is right for a task branch and wrong
				// for long-lived work whose history is already published. This merges.
				"label": "Git: Merge Origin Default into Current Branch",
				"detail": "Fetch, then MERGE origin's default branch — auto-detected, so `develop` in VanillaLand — into whatever branch the chosen checkout is on. Commits locally and NEVER pushes. On conflict the merge is LEFT IN PROGRESS and every unmerged file is named in devkit's logs/git-merge-origin-default-into-current-branch.log; hand that file to a coding agent.",
				"type": "process",
				"command": "python",
				"args": [
					"scripts/notify-wrap.py",
					"Git: Merge Origin Default into Current Branch",
					"--",
					"python",
					"scripts/log-wrap.py",
					"Git: Merge Origin Default into Current Branch",
					"--",
					"python",
					"scripts/git-merge-default.py",
					"--checkout",
					"${input:mergeCheckout}",
					"--base",
					"${input:mergeBase}"
				],
				"options": {
					"cwd": "${workspaceFolder:devkit}"
				},
				"icon": {
					"id": "git-merge",
					"color": "terminal.ansiBrightCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			// --- generic: Docker ------------------------------------------------
			// Two kinds live here. The first two are STACK-scoped: they act on the
			// chosen project's own compose topology, which genuinely differs (carameli
			// waits on healthchecks, ibkr_trader scopes to its ibkr/app profiles), so
			// they delegate to that project's script and the shared thing is the CLI
			// contract. The rest are DAEMON-scoped — one Docker Desktop per machine —
			// and delegate only so a project can override the teardown.
			{
				"label": "Docker: Start Stack",
				"detail": "Build and start each selected checkout's stack sequentially, then wait for healthchecks. The default build task (Ctrl+Shift+B). A checkout with no Docker tier says so by name.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"docker-up"
				],
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"icon": {
					"id": "vm-running",
					"color": "terminal.ansiGreen"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Docker: Stop Stack",
				"detail": "Stop each selected checkout's containers sequentially. Named volumes and their data survive — this is `down`, never `down -v`.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"docker-down"
				],
				"icon": {
					"id": "vm-outline",
					"color": "terminal.ansiYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"showReuseMessage": false,
					"close": false
				},
				"problemMatcher": []
			},
			{
				"label": "Docker: Restart Engine",
				"detail": "Unsticks a daemon hung on 'Starting the Docker Engine': kill processes → wsl --shutdown → relaunch → poll until `docker info` answers. Uses the chosen project's own scripts/docker-restart-engine.py when it ships one.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:daemonProject}",
					"docker-restart-engine"
				],
				"icon": {
					"id": "debug-restart",
					"color": "terminal.ansiBlue"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			{
				"label": "Docker: Fix Stalled Desktop",
				"detail": "The aggressive escalation from 'Restart Engine' — two stop/start rounds and a doubled poll window, for a Docker Desktop that never finishes starting. Uses the chosen project's own scripts/docker-fix.py when it ships one.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:daemonProject}",
					"docker-fix"
				],
				"icon": {
					"id": "tools",
					"color": "terminal.ansiYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			{
				"label": "Docker: Prune + Compact VHDX",
				"detail": "For each selected checkout sequentially: reclaim image/build-cache space and compact the WSL2 VHDX. Never touches named volumes; project overrides may tear down and restore their own stack.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"${input:project}",
					"docker-prune"
				],
				"icon": {
					"id": "trash",
					"color": "terminal.ansiRed"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"close": false,
					"clear": true
				},
				"problemMatcher": []
			},
			{
				// Machine scope, not project scope — so no `${input:project}`. The three
				// things that make this laptop slow after a few hours are unrelated to
				// each other and only one of them is Docker's, which is why this is not
				// another mode of "Docker: Prune + Compact VHDX". See ACTIONS["reclaim"].
				"label": "Machine: Reclaim Resources",
				"detail": "Stops every running container (docker stop, never down — named volumes and stopped state survive), deletes RDP traces / WSL crash dumps / pytest scratch / node cache and loose %TEMP% files older than 3 days, then reconciles ephemeral boxes — but only once the disk is clear of the 20 GB floor reconcile reaps open PRs at. Reports commit charge; it cannot free memory.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"reclaim"
				],
				"icon": {
					"id": "flame",
					"color": "terminal.ansiBrightRed"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"clear": true,
					"close": false
				},
				"problemMatcher": []
			},
			{
				// Reviewing a UI change before its PR merges. Machine scope, not project
				// scope — there is one box registry and one port registry on this machine, so
				// the checkout is a dimension inside the ANSWER rather than a scope for the task:
				// `previewProject` asks which one, `previewRow` lists that one's refs. See
				// ACTIONS["preview"].
				//
				// `focus` because the terminal menu is still reachable — the `Rescan` row falls
				// through to it — and without it that answer is typed into whatever had focus
				// when the task was clicked.
				"label": "Preview: Open a UI Branch",
				"detail": "Asks which checkout, then which of its refs — preview boxes already standing, live agent boxes, open PRs, recent agent/ branches on origin — and brings each one's stack up in a box of its own, opening the URL it publishes. Tick as many refs as you want: the boxes start in turn and then wait together, so several cost the slowest rather than the sum, and a ref already standing on a port is refreshed there instead of being cut a second time. Both lists are what the last run found; every checkout ends in a 'Rescan' row that looks again and then asks in the terminal. Cutting a box for the first time builds its images and installs the frontend's dependencies — about three minutes, reported stage by stage, and the tab opens only once the page answers; re-serving one that is already standing takes seconds. A running preview costs CPU until 'Machine: Reclaim Resources' stops it.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"preview",
					"--pick-ref",
					"${input:previewRow}"
				],
				"icon": {
					"id": "preview",
					"color": "terminal.ansiBrightMagenta"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"focus": true,
					"clear": true,
					"close": false
				},
				// VS Code allows ONE instance of a task by default, and re-running a task
				// that is already active offers to terminate it. Comparing two branches
				// side by side is the normal way to use this one, and every box has its own
				// port lease and COMPOSE_PROJECT_NAME, so nothing below the task was ever
				// the thing serialising them. Four rather than unbounded: a cold box builds
				// images and each running preview costs CPU until it is stopped.
				"runOptions": {
					"instanceLimit": 4
				},
				"problemMatcher": []
			},
			{
				// The same two dropdowns, cutting the CHEAP kind of box: only the project's
				// `[worktree] ui_services` start, and the backend is borrowed from the static
				// checkout's running stack on its usual ports. A project that has not declared
				// a UI tier in `.devkit.toml` says so and points at the full task above.
				"label": "Preview: Open a UI Branch (Frontend Only)",
				"detail": "The cheap preview: same two dropdowns as 'Open a UI Branch' — tick as many refs as you want — but each box starts only the project's declared UI services (e.g. the Vite frontend) and points them at the static checkout's already-running backend instead of cloning the whole stack — one container and no image builds, so about a minute the first time a box is cut (the frontend installs its dependencies) and seconds after that. Needs that checkout's stack up ('Docker: Start Stack'); it says so before it starts when nothing is listening on that port. Refs whose change is not frontend-only will not show it here; use the full preview.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"preview",
					"--pick-ref",
					"${input:previewRow}",
					"--ui"
				],
				"icon": {
					"id": "preview",
					"color": "terminal.ansiBrightCyan"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"focus": true,
					"clear": true,
					"close": false
				},
				// Same reason as the full preview above: several of these at once is the
				// point of them, and the default limit of 1 turns the second click into an
				// offer to kill the first.
				"runOptions": {
					"instanceLimit": 4
				},
				"problemMatcher": []
			},
			{
				// The cheapest preview of all: the same two dropdowns, and then NO Docker —
				// host Vite serves each ticked ref's frontend from a plain worktree copy,
				// which is all a UI-only review needs. Boxes are still first-class: a ref
				// with a live box is served from that box's worktree as it stands, unpushed
				// work included. See ACTIONS["preview-ui-host"].
				//
				// `focus` for the same reason as the full preview: the Rescan row falls
				// through to the terminal.
				"label": "Preview: Serve UI Branches on Host",
				"detail": "No Docker, no backend: serves each ticked ref's frontend straight from a host Vite dev server on its own port and opens the URLs — seconds to start, after a one-off npm install per new ref (about a minute). A ref with a live agent box is served from that box's worktree, unpushed work included; anything else gets a kept copy under .ui-previews/. API-backed views show real data when the static checkout's stack happens to be up and their offline state when it is not — a change that needs the backend wants one of the two box previews above. The servers live in this terminal: closing it, or Ctrl+C, stops them all.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"preview-ui-host",
					"--picks",
					"${input:previewRow}"
				],
				"icon": {
					"id": "preview",
					"color": "terminal.ansiBrightYellow"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"focus": true,
					"clear": true,
					"close": false
				},
				// Same reason as its siblings — though one run already serves several refs,
				// a second batch later in the day should not offer to kill the first. Ports
				// are free-scanned per server, so instances cannot collide.
				"runOptions": {
					"instanceLimit": 4
				},
				"problemMatcher": []
			},
			{
				// The same action with the menu skipped, and deliberately WITHOUT `focus`: after
				// a reboot the answer is always "all of them", so the one task that needs no
				// keyboard is the one that should not take it.
				"label": "Preview: Restart Standing Previews",
				"detail": "Brings every preview box that is already cut back up — the one-click answer after a reboot, when Docker stopped every container while the boxes, their branches and their port leases all survived, so each lands back on the port it had before. Asks nothing; a machine with no preview boxes says so and exits.",
				"type": "process",
				"command": "python",
				"args": [
					"${workspaceFolder:devkit}/scripts/devkit_project.py",
					"--project",
					"devkit",
					"preview",
					"--all"
				],
				"icon": {
					"id": "debug-restart",
					"color": "terminal.ansiBrightGreen"
				},
				"presentation": {
					"reveal": "always",
					"panel": "new",
					"clear": true,
					"close": false
				},
				"problemMatcher": []
			},
			// --- scoped: carameli's worktree pair --------------------------------
			// These three came up out of `carameli/.vscode/tasks.json`. The picker lists
			// two checkouts rather than five because that is what the action is defined
			// for — see `Action.projects` in devkit_project.py.
			{
				"label": "Test: Run Carameli Target — free",
				"detail": "Run the chosen free target sequentially in each selected Carameli checkout. '--all' merges pytest + hooks + frontend into one artifact per checkout. Paid tiers remain CLI-only.",
				"type": "process",
				"command": "python",
